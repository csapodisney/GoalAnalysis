</script>
<script type="module">
(function() {

    const fakeBubbleElement = document.getElementById("neurabot-fake-chat-bubble");
    const showCookieConsentButtonElement = document.getElementById("neurabot-show-cookie-consent-button");

    const translations = {"de":{"consentModal":{"title":"Chat-Widget Zustimmung","description":"KI-Chatbot aktivieren?\nUnser Chatbot „Vitus“ verwendet Cookies, um Ihre Chat-Sitzung zu speichern und Ihnen personalisierte Antworten anzubieten. Um die Sitzung zu starten, müssen Sie der erforderlichen Datenübertragung an den Dienstleister neuraflow GmbH zustimmen. Weitere Informationen finden Sie hier:\nhttps://stadt.mg/DS-Chatbot","acceptAllBtn":"Akzeptieren","acceptNecessaryBtn":"Ablehnen"},"preferencesModal":{"title":"Cookie-Einstellungen","acceptAllBtn":"Alle akzeptieren","acceptNecessaryBtn":"Alle ablehnen","savePreferencesBtn":"Einstellungen übernehmen","closeIconLabel":"Schließen","sections":[{"description":"KI-Chatbot aktivieren?\nUnser Chatbot „Vitus“ verwendet Cookies, um Ihre Chat-Sitzung zu speichern und Ihnen personalisierte Antworten anzubieten. Um die Sitzung zu starten, müssen Sie der erforderlichen Datenübertragung an den Dienstleister neuraflow GmbH zustimmen. Weitere Informationen finden Sie hier:\nhttps://stadt.mg/DS-Chatbot"},{"title":"Chat-Widget","linkedCategory":"necessary"}]}},"en":{"consentModal":{"title":"Chat Widget Consent","description":"Activate AI chatbot?\nOur chatbot \"Vitus\" uses cookies to save your chat session and offer you personalised answers. To start the session, you must agree to the required data transfer to the service provider neuraflow GmbH. You can find more information here:\nhttps://stadt.mg/DS-Chatbot","acceptAllBtn":"Accept","acceptNecessaryBtn":"Reject"},"preferencesModal":{"title":"Cookie Settings","acceptAllBtn":"Accept all","acceptNecessaryBtn":"Reject all","savePreferencesBtn":"Save preferences","closeIconLabel":"Close","sections":[{"description":"Activate AI chatbot?\nOur chatbot \"Vitus\" uses cookies to save your chat session and offer you personalised answers. To start the session, you must agree to the required data transfer to the service provider neuraflow GmbH. You can find more information here:\nhttps://stadt.mg/DS-Chatbot"},{"title":"Chat Widget","linkedCategory":"necessary"}]}},"es":{"consentModal":{"title":"Consentimiento del Widget de Chat","description":"¿Activar el chatbot de IA?\nNuestro chatbot \"Vitus\" utiliza cookies para guardar su sesión de chat y ofrecerle respuestas personalizadas. Para iniciar la sesión, debe aceptar la transferencia de datos necesaria al proveedor de servicios neuraflow GmbH. Encontrará más información aquí:\nhttps://stadt.mg/DS-Chatbot","acceptAllBtn":"Aceptar","acceptNecessaryBtn":"Rechazar"},"preferencesModal":{"title":"Configuración de Cookies","acceptAllBtn":"Aceptar todo","acceptNecessaryBtn":"Rechazar todo","savePreferencesBtn":"Guardar preferencias","closeIconLabel":"Cerrar","sections":[{"description":"¿Activar el chatbot de IA?\nNuestro chatbot \"Vitus\" utiliza cookies para guardar su sesión de chat y ofrecerle respuestas personalizadas. Para iniciar la sesión, debe aceptar la transferencia de datos necesaria al proveedor de servicios neuraflow GmbH. Encontrará más información aquí:\nhttps://stadt.mg/DS-Chatbot"},{"title":"Widget de Chat","linkedCategory":"necessary"}]}},"fr":{"consentModal":{"title":"Consentement du Widget de Chat","description":"Activer le chatbot IA ?\nNotre chatbot \"Vitus\" utilise des cookies pour enregistrer votre session de chat et vous proposer des réponses personnalisées. Pour démarrer la session, vous devez accepter le transfert de données nécessaire au prestataire de services neuraflow GmbH. Vous trouverez de plus amples informations ici :\nhttps://stadt.mg/DS-Chatbot","acceptAllBtn":"Accepter","acceptNecessaryBtn":"Refuser"},"preferencesModal":{"title":"Paramètres des Cookies","acceptAllBtn":"Tout accepter","acceptNecessaryBtn":"Tout refuser","savePreferencesBtn":"Enregistrer les préférences","closeIconLabel":"Fermer","sections":[{"description":"Activer le chatbot IA ?\nNotre chatbot \"Vitus\" utilise des cookies pour enregistrer votre session de chat et vous proposer des réponses personnalisées. Pour démarrer la session, vous devez accepter le transfert de données nécessaire au prestataire de services neuraflow GmbH. Vous trouverez de plus amples informations ici :\nhttps://stadt.mg/DS-Chatbot"},{"title":"Widget de Chat","linkedCategory":"necessary"}]}},"uk":{"consentModal":{"title":"Згода на віджет чату","description":"Активувати чат-бота зі штучним інтелектом?\nНаш чат-бот \"Vitus\" використовує файли cookie, щоб зберегти вашу сесію чату і запропонувати вам персоналізовані відповіді. Щоб розпочати сеанс, ви повинні дати згоду на передачу необхідних даних постачальнику послуг neuraflow GmbH. Більш детальну інформацію ви можете знайти тут:\nhttps://stadt.mg/DS-Chatbot","acceptAllBtn":"Прийняти","acceptNecessaryBtn":"Відхилити"},"preferencesModal":{"title":"Налаштування файлів cookie","acceptAllBtn":"Прийняти все","acceptNecessaryBtn":"Відхилити все","savePreferencesBtn":"Зберегти налаштування","closeIconLabel":"Закрити","sections":[{"description":"Активувати чат-бота зі штучним інтелектом?\nНаш чат-бот \"Vitus\" використовує файли cookie, щоб зберегти вашу сесію чату і запропонувати вам персоналізовані відповіді. Щоб розпочати сеанс, ви повинні дати згоду на передачу необхідних даних постачальнику послуг neuraflow GmbH. Більш детальну інформацію ви можете знайти тут:\nhttps://stadt.mg/DS-Chatbot"},{"title":"Віджет чату","linkedCategory":"necessary"}]}},"nl":{"consentModal":{"title":"Chat Widget Toestemming","description":"AI-chatbot activeren?\nOnze chatbot \"Vitus\" gebruikt cookies om je chatsessie op te slaan en je gepersonaliseerde antwoorden te geven. Om de sessie te starten, moet je akkoord gaan met de vereiste gegevensoverdracht naar de serviceprovider neuraflow GmbH. Meer informatie vind je hier:\nhttps://stadt.mg/DS-Chatbot","acceptAllBtn":"Accepteren","acceptNecessaryBtn":"Weigeren"},"preferencesModal":{"title":"Cookie-instellingen","acceptAllBtn":"Alles accepteren","acceptNecessaryBtn":"Alles weigeren","savePreferencesBtn":"Voorkeuren opslaan","closeIconLabel":"Sluiten","sections":[{"description":"AI-chatbot activeren?\nOnze chatbot \"Vitus\" gebruikt cookies om je chatsessie op te slaan en je gepersonaliseerde antwoorden te geven. Om de sessie te starten, moet je akkoord gaan met de vereiste gegevensoverdracht naar de serviceprovider neuraflow GmbH. Meer informatie vind je hier:\nhttps://stadt.mg/DS-Chatbot"},{"title":"Chat Widget","linkedCategory":"necessary"}]}},"cs":{"consentModal":{"title":"Souhlas s chatovacím widgetem","description":"Aktivovat chatbota s umělou inteligencí?\nNáš chatbot \"Vitus\" používá soubory cookie, aby uložil vaši relaci chatu a nabídl vám personalizované odpovědi. Pro spuštění relace musíte souhlasit s požadovaným přenosem dat poskytovateli služeb neuraflow GmbH. Více informací naleznete zde:\nhttps://stadt.mg/DS-Chatbot","acceptAllBtn":"Přijmout","acceptNecessaryBtn":"Odmítnout"},"preferencesModal":{"title":"Nastavení souborů cookie","acceptAllBtn":"Přijmout vše","acceptNecessaryBtn":"Odmítnout vše","savePreferencesBtn":"Uložit předvolby","closeIconLabel":"Zavřít","sections":[{"description":"Aktivovat chatbota s umělou inteligencí?\nNáš chatbot \"Vitus\" používá soubory cookie, aby uložil vaši relaci chatu a nabídl vám personalizované odpovědi. Pro spuštění relace musíte souhlasit s požadovaným přenosem dat poskytovateli služeb neuraflow GmbH. Více informací naleznete zde:\nhttps://stadt.mg/DS-Chatbot"},{"title":"Chatovací widget","linkedCategory":"necessary"}]}}};

    CookieConsentChatBot.run({
        autoShow: false,
        manageScriptTags: false,
        categories: {
            necessary: {},
        },
        language: {
            default: "de",
            autoDetect: "browser",
            translations: translations
        },
        onFirstConsent: function() {
            if (CookieConsentChatBot.acceptedCategory("necessary")) {
                const script = document.createElement("script");
                script.type = "module";
                script.src = "https://prod-chat-app.neurabot.neuraflow.de/embed-loader.js";
                document.body.appendChild(script);
                fakeBubbleElement.style.display = "none";
            }
        },
        onConsent: function() {
            if (CookieConsentChatBot.acceptedCategory("necessary")) {
                const script = document.createElement("script");
                script.type = "module";
                script.src = "https://prod-chat-app.neurabot.neuraflow.de/embed-loader.js";
                document.body.appendChild(script);
                fakeBubbleElement.style.display = "none";
            }
        },
        onChange: function({changedCategories}) {
            if (changedCategories.includes("necessary")) {
                if (!CookieConsentChatBot.acceptedCategory("necessary")) {
                    fakeBubbleElement.style.display = "flex";
                } else {
                    fakeBubbleElement.style.display = "none";
                    const script = document.createElement("script");
                    script.type = "module";
                    script.src = "https://prod-chat-app.neurabot.neuraflow.de/embed-loader.js";
                    document.body.appendChild(script);
                }
            }
        }
    });
    
    showCookieConsentButtonElement.addEventListener("click", function() {
        CookieConsentChatBot.show(true);
    });
})();
</script>
