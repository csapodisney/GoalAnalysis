.institution-schedule-segments-item-inner {
  position: relative;
  height: 450px;
  width: 100%;
}
.institution-legend {
  list-style: none;
  padding-left: 30px;
  margin-bottom: 0;
}
.institution-legend li {
  padding: 3px 0;
  position: relative;
}
.institution-legend-icon {
  position: absolute;
  top: 50%;
  left: -30px;
  height: 20px;
  width: 20px;
  margin-top: -10px;
  background-color: #666;
  color: #fff;
  text-align: center;
  line-height: 16px;
  font-size: 80%;
  border: 1px solid rgba(0, 0, 0, 0.15);
}
.institution-legend-icon-red {
  background-color: #da001a;
}
.institution-legend-icon-yellow {
  background-color: #fecc00;
}
.institution-legend-icon-green {
  background-color: #5cb85c;
}
.institution-legend-icon-gray {
  background-color: #949494;
}
.institution-calendar-has-legend .institution-calendar-column {
  padding-top: 67px;
  height: 519px;
}
.location-map {
  clear: both;
  margin: 11px 0;
  width: 100%;
  height: 200px;
}
@media (min-width: 768px) {
  .location-map {
    height: 300px;
  }
}
@media (min-width: 768px) {
  .location-image {
    margin-left: 30px;
    max-width: 50%;
    float: right;
  }
}
div.location-categories {
  margin: 10px -2px 15px -2px;
}
div.location-categories a {
  border: 0px;
  padding: 1px 7px;
  background: #F5F5F5;
  display: inline-block;
  margin: 2px;
}
div.location-categories a:hover {
  background: #d6d6d6;
}
div.location-categories a.active-aggregations {
  background: #da001a;
  color: #F5F5F5;
}
div.location-categories a.current-category {
  background: #747474;
  cursor: default;
}
.related-location {
  margin-top: 15px;
}
.related-location h3 {
  margin-top: 0;
}
.panel-heading {
  padding: 0;
}
.panel-heading .panel-title {
  position: relative;
}
.panel-heading .panel-title a {
  color: inherit;
  display: block;
  padding: 10px 15px;
  padding-right: 40px;
}
.panel-heading .panel-title a:focus,
.panel-heading .panel-title a:hover {
  color: inherit;
  background: rgba(255, 255, 255, 0.5);
}
.panel-heading .panel-title a:after {
  font-size: 16px;
  line-height: 16px;
  content: "-";
  font-family: "SSGizmo";
  position: absolute;
  right: 15px;
  top: 50%;
  margin-top: -7px;
}
.panel-heading .panel-title a.collapsed:after {
  content: "+";
}
