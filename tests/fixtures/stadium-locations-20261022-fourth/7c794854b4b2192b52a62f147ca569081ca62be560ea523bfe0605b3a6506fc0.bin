.ol-control {
  padding: 0;
  background-color: rgba(0, 0, 0, 0.3);
}
.ol-control:hover,
.ol-control:focus {
  background-color: rgba(0, 0, 0, 0.5);
}
.ol-control button {
  border-radius: 0;
  margin: 0;
  background-color: #fafafa;
  border: 1px solid #ccc;
  color: #333;
}
.ol-control button:hover,
.ol-control button:focus {
  outline: 0;
  background-color: #fff;
}
.ol-zoom button + button {
  margin-top: -1px;
}
.ol-viewport {
  overflow: visible!important;
}
.ol-overlay-container .popover {
  z-index: 999;
}
.popover {
  max-width: none;
}
.popover .popover-content {
  padding: 0px;
  width: 285px;
}
.popover .popover-content .ol-popup-content {
  width: 285px;
}
.popover .popover-content .ol-popup-content .ssk {
  background: url('/_assets/50f7a6d80db20353491a9e58d42156f4/Images/sparkasse-logo.gif');
  background-repeat: no-repeat;
  width: 285px;
  height: 85px;
}
.popover .popover-content .ol-popup-content .ol-popup-content-inner {
  padding: 15px;
}
.popover .popover-content .ol-popup-content .ol-popup-content-inner .name {
  font-weight: bold;
}
.popover .popover-content .ol-popup-content .ol-popup-content-inner .address {
  margin-bottom: 11px;
}
.popover .popover-content .ol-popup-content .ol-popup-content-inner .btn {
  margin-top: 11px;
}
.box-container .livesearch-item + .livesearch-item {
  margin-top: 5px;
}
.livesearch-item-body *:first-child,
.livesearch-item-media *:first-child {
  margin-top: 0;
}
.livesearch-item-body *:last-child,
.livesearch-item-media *:last-child {
  margin-bottom: 0;
}
.livesearch-item-breadcrumb {
  padding: 0;
  list-style: none;
  font-size: 14px;
  color: #cccccc;
  margin-bottom: 5px;
}
.livesearch-item-breadcrumb li {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: none;
  max-width: 200px;
}
.livesearch-item-breadcrumb li a {
  color: #848484;
}
.livesearch-item-breadcrumb li:before {
  display: none;
  content: "/";
  color: #cccccc;
  margin: 0 4px;
}
.livesearch-item-breadcrumb li:nth-last-child(1):first-child:before,
.livesearch-item-breadcrumb li:nth-last-child(2):first-child:before,
.livesearch-item-breadcrumb li:nth-last-child(3):first-child:before,
.livesearch-item-breadcrumb li:nth-last-child(3):before {
  display: none;
}
.livesearch-item-breadcrumb li:last-child {
  display: inline-block;
  max-width: none;
}
.livesearch-item-breadcrumb li:last-child a {
  color: #727272;
}
@media (min-width: 480px) {
  .livesearch-item-breadcrumb li:nth-last-child(2) {
    display: inline-block;
  }
