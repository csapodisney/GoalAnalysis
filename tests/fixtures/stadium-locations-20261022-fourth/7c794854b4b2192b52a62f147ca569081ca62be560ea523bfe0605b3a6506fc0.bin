                    </label><input id="thumbsUpDownForm-20035773-hidden-5" class="form-control" type="text" name="tx_form_formframework[thumbsUpDownForm-20035773][hidden-5]" value="" /></div><div class="form-element form-element-text mb-3"><label class="form-label" for="thumbsUpDownForm-20035773-hidden-6">browserLanguage
                        
                    </label><input id="thumbsUpDownForm-20035773-hidden-6" class="form-control" type="text" name="tx_form_formframework[thumbsUpDownForm-20035773][hidden-6]" value="" /></div><div class="form-element form-element-text mb-3"><label class="form-label" for="thumbsUpDownForm-20035773-hidden-7">browserOnline
                        
                    </label><input id="thumbsUpDownForm-20035773-hidden-7" class="form-control" type="text" name="tx_form_formframework[thumbsUpDownForm-20035773][hidden-7]" value="" /></div><div class="form-element form-element-text mb-3"><label class="form-label" for="thumbsUpDownForm-20035773-hidden-8">platform
                        
                    </label><input id="thumbsUpDownForm-20035773-hidden-8" class="form-control" type="text" name="tx_form_formframework[thumbsUpDownForm-20035773][hidden-8]" value="" /></div><div class="form-element form-element-text mb-3"><label class="form-label" for="thumbsUpDownForm-20035773-hidden-9">userAgentHeader
                        
                    </label><input id="thumbsUpDownForm-20035773-hidden-9" class="form-control" type="text" name="tx_form_formframework[thumbsUpDownForm-20035773][hidden-9]" value="" /></div><div class="form-element form-element-text mb-3"><label class="form-label" for="thumbsUpDownForm-20035773-hidden-10">isMobile
                        
                    </label><input id="thumbsUpDownForm-20035773-hidden-10" class="form-control" type="text" name="tx_form_formframework[thumbsUpDownForm-20035773][hidden-10]" value="" /></div><div class="form-element form-element-text mb-3"><label class="form-label" for="thumbsUpDownForm-20035773-hidden-11">url
                        
                    </label><input id="thumbsUpDownForm-20035773-hidden-11" class="form-control" type="text" name="tx_form_formframework[thumbsUpDownForm-20035773][hidden-11]" value="" /></div><div class="form-actions"><nav class="form-navigation" aria-label="Form Navigation"><button class="btn btn-primary" type="submit" name="tx_form_formframework[thumbsUpDownForm-20035773][__currentPage]" value="1">
                Absenden
            </button></nav></div></form></div></div><button class="dialog__close" aria-label="schließen"><i class="fa fa-close"></i></button><span class="dialog__footer-text">Es werden keine personenbezogenen Daten übermittelt. Wir erhalten neben den Formulardaten auch allgemeine technische Daten [navigator object properties], die uns bei Anzeigefehlern die Ursachensuche erleichtern.</span></dialog></div></div><script>
              let dialogElementN = document.getElementById('dialog-n');
              let dialogElementP = document.getElementById('dialog-p');

              dialogElementN.addEventListener('click', function(e) {
                e.stopPropagation();
              });
              
              if(dialogElementN){
                const form = dialogElementN.querySelector('form');

                if(form) {
                  console.log(form);

                  const captchaInput = form.querySelector('*[id*=captcha]');
                  const pidInput = form.querySelector('*[id$=hidden-1]');
                  const browserCodeNameInput = form.querySelector('*[id$=hidden-2]');
                  const browserNameInput = form.querySelector('*[id$=hidden-3]');
                  const browserVersionInput = form.querySelector('*[id$=hidden-4]');
                  const cookiesEnabledInput = form.querySelector('*[id$=hidden-5]');
                  const browserLanguageInput = form.querySelector('*[id$=hidden-6]');
                  const browserOnlineInput = form.querySelector('*[id$=hidden-7]');
                  const platformInput = form.querySelector('*[id$=hidden-8]');
                  const userAgentHeaderInput = form.querySelector('*[id$=hidden-9]');
                  const mobileInput = form.querySelector('*[id$=hidden-10]');
                  const urlInput = form.querySelector('*[id$=hidden-11]');

                  pidInput.value = dialogElementN.getAttribute('data-pid');
                  browserCodeNameInput.value = navigator.appCodeName;
                  browserNameInput.value = navigator.appName;
                  browserVersionInput.value = navigator.appVersion;
                  cookiesEnabledInput.value = navigator.cookieEnabled;
                  browserLanguageInput.value = navigator.language;
                  browserOnlineInput.value = navigator.onLine;
                  platformInput.value = navigator.platform;
                  userAgentHeaderInput.value = navigator.userAgent;
                  urlInput.value = window.location.href;

                  const isMobile = navigator.userAgent.match(/(iPhone|iPod|iPad|blackberry|android|Kindle|htc|lg|midp|mmp|mobile|nokia|opera mini|palm|pocket|psp|sgh|smartphone|symbian|treo mini|Playstation Portable|SonyEricsson|Samsung|MobileExplorer|PalmSource|Benq|Windows Phone|Windows Mobile|IEMobile|Windows CE|Nintendo Wii)/i);
                  mobileInput.value = isMobile;

                  const button = form.querySelector('.btn-primary');

                  button.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();

                    captchaInput.value = captchaInput.value.toLowerCase();

                    $.ajax({
                      type: "POST",
                      url: form.getAttribute('action'),
                      data: $(form).serialize() + '&' + button.getAttribute('name') + '=' + button.getAttribute('value'),
                      success: function(data)
                      {
                          dialogElementN.close();

                      },
                      error: function(request, status, error)
                      {
                          console.log('error', error)
                      }
                    });
                  });

                  document.getElementById('action-n').addEventListener('click',e => {
                    dialogElementN.showModal();
                  });
                
                }       
              }

              dialogElementP.addEventListener('click', function(e) {
                e.stopPropagation();
              });
              
              if(dialogElementP){
                const form = dialogElementP.querySelector('form');     

                document.getElementById('action-p').addEventListener('click',e => {
                    dialogElementP.showModal();
                });
                
                if(form) {
                  const captchaInput = form.querySelector('*[id*=captcha]');
                  const pidInput = form.querySelector('*[id$=hidden-1]');
                  const browserCodeNameInput = form.querySelector('*[id$=hidden-2]');
                  const browserNameInput = form.querySelector('*[id$=hidden-3]');
                  const browserVersionInput = form.querySelector('*[id$=hidden-4]');
                  const cookiesEnabledInput = form.querySelector('*[id$=hidden-5]');
                  const browserLanguageInput = form.querySelector('*[id$=hidden-6]');
                  const browserOnlineInput = form.querySelector('*[id$=hidden-7]');
                  const platformInput = form.querySelector('*[id$=hidden-8]');
                  const userAgentHeaderInput = form.querySelector('*[id$=hidden-9]');
                  const mobileInput = form.querySelector('*[id$=hidden-10]');
                  const urlInput = form.querySelector('*[id$=hidden-11]');
                  

                  pidInput.value = dialogElementN.getAttribute('data-pid');
                  browserCodeNameInput.value = navigator.appCodeName;
                  browserNameInput.value = navigator.appName;
                  browserVersionInput.value = navigator.appVersion;
                  cookiesEnabledInput.value = navigator.cookieEnabled;
                  browserLanguageInput.value = navigator.language;
                  browserOnlineInput.value = navigator.onLine;
                  platformInput.value = navigator.platform;
                  userAgentHeaderInput.value = navigator.userAgent;
                  urlInput.value = window.location.href;

                  const isMobile = navigator.userAgent.match(/(iPhone|iPod|iPad|blackberry|android|Kindle|htc|lg|midp|mmp|mobile|nokia|opera mini|palm|pocket|psp|sgh|smartphone|symbian|treo mini|Playstation Portable|SonyEricsson|Samsung|MobileExplorer|PalmSource|Benq|Windows Phone|Windows Mobile|IEMobile|Windows CE|Nintendo Wii)/i);
                  mobileInput.value = isMobile;

                  const button = form.querySelector('.btn-primary');


                  button.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();

                    captchaInput.value = captchaInput.value.toLowerCase();

                    $.ajax({
                      type: "POST",
                      url: form.getAttribute('action'),
                      data: $(form).serialize() + '&' + button.getAttribute('name') + '=' + button.getAttribute('value'),
                      success: function(data)
                      {
                        dialogElementP.close();
                      },
                      error: function(request, status, error)
                      {
                          console.log('error', error)
                      }
                    });

                  });
                }
              }
              
              document.querySelectorAll('.dialog__close').forEach(el => {
                el.addEventListener('click',e => {
                  dialogElementP.close();
                  dialogElementN.close();
                });
              });

              document.body.addEventListener('click', (e) => {
                  if(!e.target.closest('#action-n')) dialogElementN.close();
                  if(!e.target.closest('#action-p')) dialogElementP.close();
              });
          </script><style>
                #dialog-p input[type=text],#dialog-n input[type=text]{
                  display: none;
                }
  
                #dialog-p .form-group .control-label, #dialog-n .form-group .control-label {
                  display: none;
                }

                #dialog-n input[id*=captcha] {
                  display: block;
                  width: 100%;
                  max-width: 150px;
                }

                #dialog-p input[id*=captcha] {
                  display: block;
                  width: 100%;
                  max-width: 150px;
                }
  
                .action-p, .action-n {
                  background-color: white;
                }
  
                .dialog {
                  padding: 30px;
                  opacity: 0;
                  pointer-events: none;
                  display: block;
                  transition: opacity 0.6s ease;
                  inset-block-start: 0px;
                  inset-block-end: 0px;
                  position: fixed;
                }
  
                .dialog[open] {
                  opacity: 1;
                  pointer-events: all;
                }
  
                .positive-negative-form {
                  margin-top: 15px;
                }
  
                .positive-negative-form__triggers {
                  display: flex;
                  justify-content: flex-end;
                  align-items: center;
                  width: 100%;
                }
  
                .positive-negative-form__trigger {
                  margin-left: 4px;
                }
  
                
  
                .dialog__close {
                  position: absolute;
                  right: 20px;
                  top: 20px;
                  background-color: transparent;
                  padding: 0;
                  margin: 0;
                  border: none;
                }
  
                .dialog__header {
                  margin-top: 0;
                  margin-bottom: 8px;
                  padding-bottom: 8px;
                  border-bottom: 1px solid #e5e5e5;
                }
  
                .dialog__footer-text {
                  font-size: 10px;
                }

                .positive-negative-form .ce-form_formframework.no-box {
                    border: none;
                }
  
  
              </style></div></div></footer><script type="text/template" id="event-map-marker-template"><div class="ol-popup-content"><% if (partner == "1") { %><div class="ssk"></div><% }; %><div class="ol-popup-content-inner"><div class="name"><%- title %></div><div class="address"><span class="street"><%- street %></span><br/><span class="zip"><%- zip %></span><span class="city"><%- city %></span></div><% if (email != undefined) { %><div class="email text-ellipsis"><i class="ss-icon ss-mail"></i><a href="mailto:<%- email %>" target="_blank"><%- email %></a></div><% }; %><% if (web) { %><div class="web text-ellipsis"><i class="ss-icon ss-globe"></i><a href="http://<%- web %>" target="_blank"><%- web %></a></div><% }; %><% if (phone) { %><div class="phone"><i class="ss-icon ss-phone"></i><%- phone %></div><% }; %><% if (fax) { %><div class="fax"><i class="ss-icon ss-fax"></i><%- fax %></div><% }; %><a class="btn btn-primary" href="<%- url %>">mehr Informationen</a></div></div></script><script type="text/template" id="common-searched-result-template"><div class="col-sm-6"><nav><ul class="nav nav-structured"><% _.each(items.left, function(item) { %><li><a href="#search/<%- item.title %>"><%- item.title %></a></li><% }); %></ul></nav></div><div class="col-sm-6 hidden-xs"><nav><ul class="nav nav-structured"><% _.each(items.right, function(item) { %><li><a href="#search/<%- item.title %>"><%- item.title %></a></li><% }); %></ul></nav></div></script><script type="text/template" id="search-result-template"><div class="section"><div class="container"><div class="row"><% if (items.length === 0) { %><div class="col-md-12"><div class="box-container"><div class="row"><div class="col-md-12"><div class="box box-white media media-search media-search-no-results"><%- translate('no_results') %></div></div></div></div></div><% } else { %><div class="col-md-8"><div class="box-container"><div class="row"><div class="col-md-12"><div class="box box-white livesearch-item"><p class="lead"><%- translate('search_term') %>: <strong><%- search %></strong><br><% _.each(sorting, function(sort, title) { %><% if (sort.active) { %><small><%- translate('search_sorting') %>: <%- translate(title) %></small><% }; %><% }); %></p><p><%- translate('search_hint_filter') %><br><%= translate('search_hint_council_information_system') %></p></div><% _.each(items, function(item) { %><div class="box box-white livesearch-item"><% if (item.breadcrumbs.length > 0) { %><ol class="livesearch-item-breadcrumb"><% _.each(item.breadcrumbs, function(breadcrumb) { %><li><a href="<%= baseUrl %><%- breadcrumb.link %>" title="<%- breadcrumb.title %>"><%- breadcrumb.title %></a></li><% }); %></ol><% }; %><div class="livesearch-item-content"><div class="livesearch-item-body"><h3></h3><h2 class="livesearch-item-title"><a href="<%= baseUrl %><%- item.link %>" title="<%- item.title %>"><%- item.short.title %></a></h2><p class="description"><%= item.short.description %></p><a href="<%= baseUrl %><%- item.link %>" title="<%- item.title %>"><%- translate('open_link') %></a></div><% if (item.image.source) { %><div class="livesearch-item-media"><a href="<%= baseUrl %><%- item.link %>" title="<%- item.title %>"><figure class="image"><img src="<%- item.image.source %>" alt="<%- item.image.alt %>" title="<%- item.image.title %>"></figure></a></div><% }; %></div></div><% }); %></div></div></div></div><div class="col-md-4"><div class="box-container"><div class="box box-transparent"><% if (pagination.enabled) { %><% if (pagination.itemTo > totalHits) { %><p><%- translate('search_header_1') %><strong><%- pagination.itemFrom %><%- translate('search_header_2') %><%- totalHits %></strong><%- translate('search_header_3') %><strong><%- totalHits %></strong></p><% } else { %><p><%- translate('search_header_1') %><strong><%- pagination.itemFrom %><%- translate('search_header_2') %><%- pagination.itemTo %></strong><%- translate('search_header_3') %><strong><%- totalHits %></strong></p><% }; %><% }; %><% if (pagination.enabled && pagination.pages > 1) { %><hr><form class="page-selector livesearch-page-selector"><span class="livesearch-page-selector-item"><% if (pagination.previous > 0) { %><button type="button" class="livesearch-page-selector-previous" data-page="<%- pagination.previous %>"><i class="ss-icon ss-navigateleft"></i></button><% } else {  %><button type="button" class="livesearch-page-selector-previous" disabled="true"><i class="ss-icon ss-navigateleft"></i></button><% }; %></span><span class="livesearch-page-selector-item livesearch-page-selector-label"><%- translate('search_pagination_page') %></span><span class="livesearch-page-selector-item livesearch-page-selector-select"><select class="form-control"><% for(var i=1; i <= pagination.pages; i++) { %><% if (pagination.page == i) { %><option value="<%- i %>" selected="selected"><%- i %></option><% } else { %><option><%- i %></option><% }; %><% }; %></select></span><span class="livesearch-page-selector-item livesearch-page-selector-pages"><%- translate('search_pagination_page_from') %><%- pagination.pages %></span><span class="livesearch-page-selector-item"><% if (pagination.next <= pagination.pages) { %><button type="button" class="livesearch-page-selector-next" data-page="<%- pagination.next %>"><i class="ss-icon ss-navigateright"></i></button><% } else { %><button type="button" class="livesearch-page-selector-next" disabled="true"><i class="ss-icon ss-navigateright"></i></button><% }; %></span></form><% }; %><hr><h3><%- translate('sorting') %></h3><div class="nav-plain"><ul class="nav livesearch-sorting"><% _.each(sorting, function(sort, title) { %><% if (sort.active) { %><li class="active"><a href="#" data-sorting-title="<%- title %>" data-sorting-order="<%- sort.order %>"><%- translate(title) %><i class="nav-plain-active-icon ss-icon ss-check"></i></a></li><% } else { %><li><a href="#" data-sorting-title="<%- title %>" data-sorting-order="<%- sort.order %>"><%- translate(title) %></a></li><% }; %><% }); %></ul></div><% _.each(aggregations.items, function(aggregation, key) { %><% if (aggregation.buckets.length > 0 && key != 'date') { %><hr><div class="aggregation-wrapper aggregation-scrollable"><h3><%- translate(key) %></h3><div class="nav-plain"><ul class="nav"><% _.each(aggregation.buckets, function(bucket) { %><% if (bucket.key.length > 0) { %><% if (bucket.active) { %><li class="active livesearch-aggregations"><a href="#" data-aggregation-key="<%- key %>" data-aggregation-bucket-key="<%- bucket.key %>"><%- translate(bucket.key) %><% if (aggregations.showBucketAmount) { %>(<%- bucket.doc_count %>)<% }; %><i class="nav-plain-active-icon ss-icon ss-check"></i></a></li><% } else { %><li class="livesearch-aggregations"><a href="#" data-aggregation-key="<%- key %>" data-aggregation-bucket-key="<%- bucket.key %>"><%- translate(bucket.key) %><% if (aggregations.showBucketAmount) { %>(<%- bucket.doc_count %>)<% }; %></a></li><% }; %><% }; %><% }); %></ul></div></div><% }; %><% }); %></div></div></div><% }; %></div></div></div></script><script type="text/template" id="event-aggregation-date-template"><ul class="nav"><% _.each(dates, function(date, key) { %><li><% if (date.length == 1) { %><a href="#" class="livesearch-aggregations-date-trigger" data-aggregation-bucket-key="<%- dateformat(date[0]) %>"><%- translate(key) %></a><% } else { %><a href="#" class="livesearch-aggregations-date-trigger" data-aggregation-bucket-key="<%- dateformat(date[0]) %>|<%- dateformat(date[1]) %>"><%- translate(key) %></a><% }; %></li><% }); %><% if (active) { %><li class="active"><a href="#" class="datepicker-selector"><%- translate('datepicker') %><i class="nav-plain-active-icon ss-icon ss-check"></i></a></li><% } else { %><li><a href="#" class="datepicker-selector"><%- translate('datepicker') %></a></li><% }; %><li class="livesearch-aggregations"><a href="#" id="livesearch-aggregation-date" data-aggregation-key="date" style="display: none"><%- translate('datepicker') %></a><div class="input-group input-daterange" <% if (!active) { %>style="display: none;"<% }; %>><input type="text" class="form-control date-range-from" value="<% if (active) { %><%- moment(values.from).locale("de").format("L") %><% } %>"><span class="input-group-addon"><%- translate('datepicker_to') %></span><input type="text" class="form-control date-range-to" value="<% if (active) { %><%- moment(values.to).locale("de").format("L") %><% } %>"><span class="input-group-btn"><button type="submit" class="btn btn-default" disabled="disabled"><i class="ss-icon ss-search"></i></button></span></div></li><li class="livesearch-aggregations"><a href="#" id="livesearch-aggregation-date-reset" data-aggregation-key="date" style="display: none"></a></li></ul></script><script type="text/template" id="clubs-result-template"><div class="col-md-8"><div class="box-container"><div class="row"><div class="col-md-12"><div class="box box-white"><h1><%- translate('clubs_header') %></h1><div class="panel-group"><form method="post" action="#" name="search_clubs"><fieldset><input type="text" value="" size="22" id="club-search"></fieldset></form></div><div class="panel-group" id="accordion-clubs" role="tablist" aria-multiselectable="true"><% _.each(items, function(item, key) { %><div class="panel panel-default panel-search-target" data-title="<%- item.title %>"><div id="club-<%- key %>" class="panel-heading" role="tab"><h4 class="panel-title"><a data-toggle="collapse" data-parent="#accordion-clubs" href="#accordion-clubs-<%- key %>" aria-expanded="false" aria-controls="accordion-clubs-<%- key %>" class="collapsed"><%- item.title %></a></h4></div><div id="accordion-clubs-<%- key %>" class="panel-collapse collapse" role="tabpanel" aria-labelledby="accordion-clubs-heading-<%- key %>"><div class="panel-body"><p><% if (item.club_contact) { %><%- item.club_contact %><br><% }; %><%- item.location.adress.street %><br><%- item.location.adress.zip %><%- item.location.adress.city %><br><% if (item.location.phone) { %><%- translate('location_phone') %>: <%- item.location.phone %><br><% }; %><% if (item.location.fax) { %><%- translate('location_fax') %>: <%- item.location.fax %><br><% }; %><% if (item.location.web) { %><%- translate('location_web') %>: <%- item.location.web %><br><% }; %><% if (item.location.email) { %><%- translate('location_email') %>: <a href="mailto:<%- item.location.email %>"><%- item.location.email %></a><br><% }; %></p></div></div></div><% }); %></div></div></div></div></div></div></script><div class="loading-animation"></div>
