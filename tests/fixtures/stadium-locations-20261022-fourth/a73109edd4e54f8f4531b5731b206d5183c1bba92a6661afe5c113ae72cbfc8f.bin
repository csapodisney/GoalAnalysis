				<div class="gm-container"><div class="gm-logo"><a href="https://fck.de/" ><img decoding="async" src="https://fck.de/wp-content/uploads/2025/10/1-fck_u_novoline.png" width="198" height="58" class="gm-logo__img gm-logo__img-mobile-alt" alt="Logo des 1. FC Kaiserslautern" /><img decoding="async" src="https://fck.de/wp-content/uploads/2025/10/1-fck_u_novoline.png" width="198" height="58" class="gm-logo__img gm-logo__img-sticky-alt-mobile" alt="Logo des 1. FC Kaiserslautern" /></a>	<style>
		/* Verstecke das Original-Logo auf Mobile */
		@media (max-width: 1024px) {
			.gm-navbar .gm-logo > a {
				display: none !important;
			}

			/* Container für die zwei Logos */
			.fck-dual-logos {
				display: flex !important;
				align-items: center;
				justify-content: center;
				gap: 55px;
				width: 100%;
			}

			/* Einzelne Logo-Links */
			.fck-dual-logos a {
				display: flex;
				align-items: center;
			}

			/* Logo-Bilder - Wichtig: width und height aus HTML-Attributen erzwingen */
			.gm-navbar .gm-logo .fck-dual-logos img,
			.fck-dual-logos img {
				display: block !important;
				width: auto !important;
				height: auto !important;
				max-width: none !important;
				max-height: none !important;
				min-width: auto !important;
				min-height: auto !important;
			}

			/* Spezifische Größen für jedes Logo */
			.gm-navbar .gm-logo .fck-dual-logos .fck-logo-mobile,
			.fck-dual-logos .fck-logo-mobile {
				width: 44px !important;
				height: 44px !important;
			}

			.gm-navbar .gm-logo .fck-dual-logos .novoline-logo-mobile,
			.fck-dual-logos .novoline-logo-mobile {
				width: 93px !important;
				height: 19px !important;
			}
		}

		/* Verstecke die zwei Logos auf Desktop */
		@media (min-width: 1025px) {
			.fck-dual-logos {
				display: none !important;
			}
		}
	</style>

