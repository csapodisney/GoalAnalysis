    <script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        // Prüfe ob Job-Filter Parameter in der URL vorhanden sind
        var urlParams = new URLSearchParams(window.location.search);
        var hasJobCategory = urlParams.has('job-category');
        var hasJobSearch = urlParams.has('job-search');

        // Wenn Job-Filter Parameter vorhanden sind, springe zum Stellenanzeigen-Anker
        if (hasJobCategory || hasJobSearch) {
            var stellenanzeigenElement = document.getElementById('stellenanzeigen');
            if (stellenanzeigenElement) {
                // Kurze Verzögerung, damit die Seite vollständig geladen ist
                setTimeout(function() {
                    stellenanzeigenElement.scrollIntoView({ behavior: 'smooth' });
                    // Setze den Hash in der URL OHNE die Seite neu zu laden
                    if (window.location.hash !== '#stellenanzeigen') {
                        var newUrl = window.location.protocol + '//' + window.location.host + window.location.pathname + window.location.search + '#stellenanzeigen';
                        history.replaceState(null, null, newUrl);
                    }
                }, 300); // Längere Verzögerung für bessere Kompatibilität
            }
        }
    });
    </script>
