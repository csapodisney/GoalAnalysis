--DamesRoodDefault: #e51b24;
--DamesRoodDonker: #780005;
--JeugdGeelDefault: #f3c309;
--JeugdGeelDonker: #6f4d17;
--Hoofdsponsor711Rood: #ed2433;
--MainTextColor: #000;
--AltTextColor: #fff;
--MainBgColor: #fff;
--AltBgColor: #060606;
--ContrastBgColor: #f0f0f0;
--MainBorderColor: #919191;
/** FONTS **/
--Anton: 'Anton', sans-serif;
--Roboto: 'Roboto', sans-serif;
--Bebas: 'Bebas Neue', sans-serif;
--Montserrat: 'Montserrat', sans-serif;
--Poppins: 'Poppins', sans-serif;
}
/*****selectie CLASSES*****/
.selectieTS .cta-paragraph__content {
align-items: baseline;
}
.teamfotoheaderTS .cta-paragraph__content-container{
align-self: flex-start;
}
.stickyMenuTS {position: -webkit-sticky;
position: sticky;
top: 0;
z-index: 3;}
/*****MULTIPURPOSE CLASSES*****/
/* max width */
.container{
max-width:1600px;
}
.box-container{
align-items: center;
}
.box-container > header,
.box-container > article,
.box-container > .AdvancedGrid__navigation{
max-width: 1600px;
}
/* bg color fixes */
.MainBgColor{
background-color: var(--MainBgColor);
}
.AltBgColor{
background-color: var(--AltBgColor);
}
.ContrastBgColor{
background-color: var(--ContrastBgColor);
}
/* padding */
@media screen and (min-width: 980px){
.universal-container-padding-sides{
padding-top: 4rem;
padding-bottom: 4rem;
}
.universal-box-padding-sides > header,
.universal-box-padding-sides > article,
.universal-box-padding-sides > .AdvancedGrid__navigation{
padding-left: 6rem;
padding-right: 6rem;
}
}
.universal-container-padding-top-bot{
padding-top: 4rem;
padding-bottom: 4rem;
}
.universal-box-padding-top-bot > header,
.universal-box-padding-top-bot > article,
.universal-box-padding-top-bot > .AdvancedGrid__navigation{
padding-top: 4rem;
padding-bottom: 4rem;
}
/* content left align for one-purpose cta's */
.text-only-cta-left-align > .container   {
margin-left: 0;
}
.text-only-cta-left-align > .container   > .cta-paragraph__content{
align-items: flex-start;
}
.text-only-cta-left-align > .container   > .cta-paragraph__content > .cta-paragraph__content-container{
--ContentElementAlignmentAlignItems: flex-start;
}
/* width 100% */
.width100 {
width: 100%;
}
/* content lijnen */
@media (min-width: 992px) {
.image-right .cta-paragraph__content-container {
margin-right: auto;
}
.image-right picture.cta-paragraph__image {
margin-right: auto;
padding-left: 2rem;
}
.image-left .cta-paragraph__content-container {
margin-right: auto;
padding-left: 2rem;
}
.image-left .cta-paragraph__image{
margin-right: auto;
}
.bg-witte-leeuwen .cta-paragraph__content {
padding-left: 0;
}
.cta-paragraph__content-container{
max-width: 80%;
}
}
.multicolumn-spacing {
max-width: 1600px;
width: 100%;
}
.multicolumn-spacing .grid-container{
justify-content: space-around;
}
/*****GENERAL & REMEDIES*****/
.bg-telstar-header header h2{
width: 52rem;
}
.bg-telstar-header section {
align-items: start;
}
.btn__text{
color: var(--Color);
}
.dunne-btn{
max-height: 25px;
min-height: unset;
}
.news-grid-list-item__button {
border-radius: unset;
background-color:black;
color: white;
font-family: anton;
font-weight: 400;
font-size: 1rem;
}
.news-gallery-list-item__title,
.news-grid-list-item__title{
font-weight: normal;
line-height: 1.5rem;
}
.news-gallery-overview__list ~ .pagination{
display: none;
}
.scroll-to-top{
background-color: var(--HerenBlauwDefault);
color: var(--AltTextColor);
}
.scroll-to-top > i{
color: inherit;
}
.bottombar a > span,
.bottombar button > span{
display: none;
}
.bottombar a > i,
.bottombar button > i{
top: unset !important;
}
.soliciteren-grid-bg-fix .AdvancedGrid__container-- {
--BackgroundColor: transparent;
}
@media screen and (min-width: 980px){
.vm-breadcrumbs{
padding-left: 6rem;
padding-right: 4rem;
}
}
/*****HEADER INSERTED CSS*****/
.megamenu__category-header-wrapper {
max-height: 350px;
}
.mobile-header-flex-direction-fix > article{
flex-direction: row;
}
.header-row2 > article > section{
justify-content: center;
}
/* gradient in bottom bar */
.transparent-header-row2{
background-image: linear-gradient(var(--AltBgColor), rgba(0, 0, 0, 0));
}
.kaartverkoop-cta{
--LineHeight: 1.125rem;
}
.kaartverkoop-cta-mobile{
--LineHeight: .825rem;
}
.kaartverkoop-cta a{
font-size: var(--FontSize);
line-height: var(--LineHeight);
}
.kaartverkoop-cta a > i{
color: inherit;
}
.hamburgermenu-icon i{
color: var(--AltTextColor);
}
.hamburgermenu-icon .icon__content{
padding: 0 12px;
}
.header-login .usermenu span {
display: none;
}
/* main menu */
.mainmenu__item:nth-of-type(2) {   background-color:var(--HerenBlauwDefault);}
.header-main-menu .mainmenu__list{
gap: 2rem;
}
.header-main-menu .mainmenu__list li:nth-of-type(2) a{
border-top: 2px solid var(--HerenBlauwDefault);
}
.header-main-menu .mainmenu__list li:nth-of-type(4) a{
border-top: 2px solid var(--DamesRoodDefault);
}
.header-main-menu .mainmenu__list li:nth-of-type(3) a{
border-top: 2px solid var(--JeugdGeelDefault);
}
@media screen and (min-width: 1440px){
.header-main-menu .mainmenu__list li:nth-of-type(6){
margin-right: 8rem;
}
.sticky-header-main-menu .mainmenu__list li:nth-of-type(6){
margin-right: unset;
}
}
@media screen and (min-width: 1440px){
.header-main-menu .mainmenu__list li:nth-of-type(4){
margin-right: 8rem;
}
}
.header-main-menu .mainmenu__list li:nth-of-type(7) a{
display: flex;
flex-direction: row;
gap: 8px;
}
.header-main-menu .mainmenu__list li:nth-of-type(7) a::before{
content: '';
background-image: url('/Files/Images/Icons/ticketicon.png');
background-size: contain;
background-repeat: no-repeat;
aspect-ratio: 31/18;
height: 18px;
}
.header-main-menu .mainmenu__list li:nth-of-type(8) a{
display: flex;
flex-direction: row;
gap: 8px;
}
.header-main-menu .mainmenu__list li:nth-of-type(8) a::before{
content: '';
background-image: url('/Files/Images/Icons/shopicon.png');
background-size: contain;
background-repeat: no-repeat;
aspect-ratio: 24/23;
height: 24px;
}
.header-main-menu-mobile .mainmenu{
display: block;
}
.header-main-menu-mobile .mainmenu ul{
width: 100%;
}
.header-main-menu-mobile .mainmenu__list li{
max-width: 8rem;
}
.header-main-menu-mobile .mainmenu__list li:nth-of-type(1n+5){
display: none;
}
/* searchbar */
.search-results{
background: #fff;
font-family: roboto;
border: solid 2px #060606;
}
.search-results h2{
font-family: inherit;
font-weight: 900;
}
.search-results li a{
max-height: 48px;
}
/* 711 button psuedo logo */
.stadion-711-btn{
margin-left: 24px;
}
.stadion-711-btn a{
display: flex;
flex-direction: row;
padding: 12px 25px;
background-color: unset;
}
/*
.stadion-711-btn a::before{
content: '';
background-image: url('/Files/Images/Logos/711-stadion.png');
background-size: contain;
background-repeat: no-repeat;
aspect-ratio: 4/1;
height: 100%;
}*/
/* login button styling */
.header-login a{
flex-direction: row;
gap: 8px;
}
.header-login a > i{
font-size: inherit;
padding-bottom: 4px;
}
.header-login a > span{
font-family: var(--Bebas);
font-size: 1.5rem;
font-weight: normal;
text-transform: capitalize;
}
/* login modal */
.login .btn{
color: #fff;
}
/* cart button psuedo */
.header-cart a{
flex-direction: row;
gap: 8px;
background-color: unset;
padding-bottom: 6px;
}
.header-cart a:hover{
background-color: unset !important;
}
@media (min-width: 1050px) {
.header-cart .topmenu__shoppingcart::after{
content: 'Cart';
font-family: var(--Bebas);
font-size: 1.5rem;
font-weight: normal;
text-transform: capitalize;
}
}
@media (max-width: 1050px){
.topmenu__shoppingcart{
width: unset !important;
}
}
.header-cart a > i{
font-size: 1.25rem;
font-weight: 900;
padding-bottom: 4px;
}
.shoppingcart__order-btn .btn__text{
color: #fff;
}
/* shoppingcart dropdown */
.shoppingcart .shoppingcart__footer .btn {
color: #fff;
justify-content: center;
}
.shoppingcart .shoppingcart__footer .btn .btn__text {
height: 30px;
}
.shoppingcart .shoppingcart__footer .btn i{
height: 52px;
}
.header-cart .shoppingcart__order-btn:hover {
background-color: var(--BaseColorSecondary) !important;
}
/* megamenu */
nav.megamenu__column {
padding: 0.4rem;
}
section.megamenu__category-header, section.megamenu__category-header:hover {
background-color:#0077C0;
color: white;
font-family: 'Bebas Neue';
font-weight: 400;
font-size:1.3rem;
}
a.megamenu__sublinks-item:hover{
color:white;
}
section.megamenu__bottomlink-wrapper{
background-color:black;
font-family: 'Bebas Neue';
font-size:1.3rem;
font-weight: normal !important;
color:white;
}
/*****HEREN HOME PAGINA INSERTED CSS*****/
/*****JUMBOTRON HEADER*****/
.jumbotron__heading {
text-shadow: 2px 2px black;
}
.jumbotron__shoutbox-intro p {
text-shadow: 1px 1px black;
}
.jumbotron__shoutbox-intro p{
color: #fff !important;
}
.jumbotron__container{
border-radius: 0 !important;
}
/* grdient over image */
.bg-main-banner  .jumbotron__container{
background-image: linear-gradient(rgba(0,0,0,0) 50%, var(--AltBgColor));
}
/* shoutbox fix */
.bg-main-banner .container {
max-width: unset;
}
.bg-main-banner .jumbotron__container{
padding-left: 15%;
}
.bg-main-banner .jumbotron__shoutbox{
width: 700px;
margin-left: 0;
}
.bg-main-banner .jumbotron__shoutbox .btn{
width: fit-content;
}
@media screen and (min-width: 992px){
.jumbotron__shoutbox {
max-width:1440px;
width:100%;
margin:auto;
position:relative;
}
}
/* jumbotron mobile header */
@media (max-width: 991px) {
.jumbotron-mobile .jumbotron__carousel-mob{
background-color: transparent;
}
.jumbotron-mobile .jumbotron__subheading{
color: #FFFFFF;
font-size: 1rem;
line-height: 1rem;
}
.jumbotron-mobile .jumbotron__heading{
font-size: 2.2rem;
line-height: 2.5rem;
}
.jumbotron-mobile .jumbotron__shoutbox-intro {
margin-top: 20px;
}
.jumbotron-mobile .jumbotron {
background: var(--AltBgColor);
}
.flickity-button {
width: 30px;
height: 30px;
}
}
.hoofdsponsor .grid-container{
gap: 1rem;
}
.hoofdsponsor .cta-paragraph__content{
padding: unset;
}
.hoofdsponsor .cta-paragraph__content-container{
justify-content: center;
}
.hoofdsponsor .cta-paragraph__header{
margin: unset;
}
/*****NEWS GRID*****/
.itempublisher-navigation__link {
color: var(--HerenBlauwDefault);
background-color: transparent !important;
border: unset;
font-family: 'Anton';
font-weight: normal;
text-transform: uppercase;
transition: color 0.15s cubic-bezier(.215,.61,.355,1);
}
.itempublisher-navigation__link--active {
border-bottom: 2px solid var(--HerenBlauwDefault);
}
.itempublisher-navigation__link:hover {
background-color: transparent !important;
color: var(--AltTextColor);
}
.news-gallery-list-item__meta {
color: #0077c0;
font-size: 0.875rem;
}
.news-gallery-list-item__title{
font-size: 1.25rem;
}
.news-grid-container > article{
margin: 0 auto;
max-width: 2230px;
}
.blog-filter-styling .blog-filters{
flex-direction: row;
flex-wrap: nowrap;
}
.blog-filter-styling .blog-filters label{
color: var(--HerenBlauwDefault);
}
/* articles styling */
.articles-box{
width: auto !important;
}
.news-grid .news-gallery-overview__list{
gap: 1rem;
}
.news-grid-button .cta-paragraph__content{
padding: 0;
}
.news-grid-button .cta-paragraph__btn-navigation span{
margin-right: 16px;
}
@supports (display:grid){
@media screen and (min-width: 1200px){
.standen-news-grid .news-gallery-overview__list {
grid-template-columns: repeat(2,1fr);
}
.bedankt-news-grid .news-gallery-overview__list {
grid-template-columns: repeat(4,1fr);
}
}
}
/* video player */
.video-player-container{
flex-grow: 0;
}
@media screen and (min-width: 993px) {
.video-player-container{
margin-top: 8rem;
}
}
.video-player-container > div{
width: 100%;
}
.bg-video-player{
width: 100%;
background-color: unset !important; /* waarom?? zou ik ook niet weten maaar dynamicweb wil moeilijk doen */
}
.bg-video-player > .cta-paragraph__container{
flex-direction: column;
}
.bg-video-player .cta-paragraph__content  {
background-color: var(--HerenBlauwDefault);
align-items: flex-start;
flex-wrap: wrap;
padding: 1rem 2rem;
}
.bg-video-player .cta-paragraph__content-container  {
justify-content: center;
}
.bg-video-player .cta-paragraph__subheader{
color: var(--AltTextColor);
font-size: 1rem;
line-height: 1rem;
font-family: 'Anton', sans-serif;
}
.bg-video-player .cta-paragraph__header{
color: var(--AltTextColor);
font-size: 1.25rem;
line-height: 1.25rem;
font-family: 'Anton', sans-serif;
}
.bg-video-player-v2{
background-color: unset !important; /* waarom?? zou ik ook niet weten maaar dynamicweb wil moeilijk doen */
background-image: unset !important;
}
.bg-video-player-v2 .cta-paragraph__content  {
align-items: flex-start;
flex-wrap: wrap;
padding: 1rem 2rem;
}
.bg-video-player-v2 .cta-paragraph__content-container  {
justify-content: center;
}
/*****WITTE LEEUWEN INTRO BOX*****/
/* intro box v2 */
.bg-witte-leeuwen .grid-container{
flex-wrap: wrap;
}
.bg-witte-leeuwen figure img{
object-position: 5px !important;
}
@media screen and (max-width: 414px) {
.bg-witte-leeuwen h2,
.bg-witte-leeuwen h3,
.bg-grote-titel h2{
font-size: 2.8rem;
line-height: 3.4rem;
}
}
.bg-witte-leeuwen .cta-paragraph__content{
padding: 1rem;
}
/* bedank pagina */
.bedankt-news-grid nav{
display: none;
}/* geschiedenis pagina */
.telstar-geschiedenis .grid-container{
justify-content: space-between;
}
.telstar-geschiedenis{
width: 100%;
}
.telstar-geschiedenis .multicolumn__item:first-child{
max-width: fit-content;
}
@media (max-width: 997px) {
.telstar-geschiedenis .multicolumn__item:last-child{
max-width: unset!important;
}
.telstar-geschiedenis  .multicolumn__item:last-child  article{
margin-right: auto;
}
}
@media (min-width: 997px) {
.telstar-geschiedenis .multicolumn__item:last-child {
margin: auto;
}
}
.telstar-geschiedenis .multicolumn__item:last-child{
max-width: 25%;
}
/*****CARROUSSEL*****/
.bannercarouselTS .carousel-cell{
padding: unset;
}
.bannercarouselTS .flickity-viewport{
height: fit-content !important;
}
.bannercarouselTS .flickity-slider{
position: relative !important;
height: fit-content !important;
display: flex;
flex-direction: row;
flex-wrap: nowrap;
}
.bannercarouselTS .multicolumn__item{
min-height: unset !important;
height: fit-content !important;
position: relative !important;
flex-shrink: 0;
left: unset !important;
transform: unset !important;
}
.bannercarouselTS .multicolumn__item .cta-paragraph{
position: relative;
}
.bannercarouselTS .multicolumn__item .cta-paragraph > .cta-paragraph__content{
position: absolute;
top: 0; left: 0; right: 0; bottom: 0;
padding: 0;
}
.bannercarouselTS .multicolumn__item .cta-paragraph > .cta-paragraph__content .cta-paragraph__content-container{
position: absolute;
right: 10%;
bottom: 10%;
}
/* Telstar all together - simple cta text first */
.bg-simple-cta-text-first .cta-paragraph__content-container{
max-width: 38rem;
}
.bg-simple-cta-text-first .cta-paragraph__container{
-ms-flex-direction: column-reverse;
flex-direction: column-reverse;
}
@media screen and (min-width: 992px){
.bg-simple-cta-text-first .cta-paragraph__container {
-ms-flex-direction: row-reverse;
flex-direction: row-reverse;
}
}
/* Product overview fix whitespace between paragraphs */
.productOverview .AdvancedGrid__row {
flex-grow: 0;
}
/* Product overview sidebar width */
.AdvancedGrid__column--592 {
max-width: 350px;
width: 100%;
}
/* onze sponsor pagina */
.onze-sponsor-711 .cta-paragraph__subheader{
color: var(--Hoofdsponsor711Rood);
}
/*****INSTAGRAM POSTS CUSTOM GRID*****/
/* verplaats title naar links */
.bg-grote-titel .cta-paragraph__content{
padding: unset;
}
/* custom grid template en responsiveness */
.images-grid > .multicolumn__container:first-of-type > .grid-container{
display:grid;
grid-template-rows: repeat(7, 1fr);
grid-template-columns: 1fr;
gap: .5em;
}
.images-grid > .multicolumn__container:first-of-type > .grid-container > div figure{
aspect-ratio: 1/1;
object-fit: cover;
object-position: center;
}
@media screen and (min-width: 360px) {
.images-grid > .multicolumn__container:first-of-type > .grid-container{
grid-template-rows: repeat(7, 1fr);
grid-template-columns: repeat(2, 1fr);
}
.images-grid > .multicolumn__container:first-of-type > .grid-container > div:nth-of-type(1){
grid-column: span 2;
grid-row:span 2;
}
.images-grid > .multicolumn__container:first-of-type > .grid-container > div:nth-of-type(4){
grid-column: span 2;
grid-row:span 2;
}
}
@media screen and (min-width: 980px) {
.images-grid > .multicolumn__container:first-of-type > .grid-container{
grid-template-columns: repeat(7, 1fr);
grid-template-rows: repeat(2, 1fr);
}
}
/***
--BaseColorPrimary: #344C18;
--BaseColorSecondary: #86C440;
--BaseColorContrast: #62CBE6;
--BaseFontPrimary: 'Oswald', sans-serif;
--BaseFontSecondary: 'Oswald', sans-serif;
--Color: #16657B;
***/
/*****PROGRAMMA&UITSLAGEN PAGINA*****/
.programma-uitslagen-headings{
margin: auto;
}
.programma-uitslagen-headings .cta-paragraph__content{
padding: 0;
}
.programma-komende-wedstrijd-container .AdvancedGrid__row{
background-image: linear-gradient(var(--AltBgColor) 50%, var(--MainBgColor) 50%);
}
.bg-programma-komende-wedstrijd{
box-shadow: 0 0 2rem var(--MainBorderColor);
border: 1px solid var(--MainBorderColor);
background-color: var(--MainBgColor);
}
@media screen and (min-width: 991px){
.bg-programma-komende-wedstrijd .multicolumn__container{
padding: 0 .8rem;
}
}
.bg-programma-komende-wedstrijd .grid-container > div:nth-of-type(2){
flex-grow: 3;
}
.bg-programma-komende-wedstrijd .grid-container > div picture{
height: 200px;
}
.programma-banner thead{
display: none;
}
.programma-banner-heading1,
.programma-banner-heading2,
.programma-banner-heading3{
display: flex;
justify-content: center;
}
.programma-banner-heading1 td{
font-family: var(--Anton);
font-size: 1.6rem;
text-transform: uppercase;
font-weight: normal;
line-height: 1.6rem;
color: var(--MainTextColor);
margin-bottom: 0.75rem;
}
.programma-banner-heading2 td{
font-family: var(--Anton);
font-size: 3rem;
text-transform: uppercase;
font-weight: normal;
line-height: 3rem;
color: var(--MainTextColor);
margin-bottom: 0.75rem;
}
.programma-banner-heading3 tr{
display: flex;
flex-wrap: wrap;
justify-content: center;
}
.programma-banner-heading3 td{
font-family: var(--Anton);
font-size: 2rem;
text-transform: uppercase;
font-weight: normal;
line-height: 2rem;
color: var(--MainTextColor);
margin-bottom: 0.75rem;
}
.uitslagen-grid{
padding-bottom: 4rem;
}
.uitslagen-grid > article{
gap: 1rem;
}
.kaartverkoop-programma-container > article{
background-repeat: no-repeat;
background-position: center;
background-size: cover;
}
.kaartverkoop-programma-pagina .header-emphasis{
color: var(--HerenBlauwDefault);
}
/*****CONTENT PAGINAS*****/
.bg-content-page-sidebar .cta-paragraph__btn-navigation{
flex-direction: column;
}
@media screen and (max-width: 992px){
.bg-content-page-sidebar .cta-paragraph__content-container{
text-align: center;
justify-content: center;
align-items: center;
}
.bg-content-page-sidebar .cta-paragraph__content {
justify-content: center;
flex-direction: row;
}
.bg-content-page-sidebar .cta-paragraph__btn-navigation{
flex-direction: row;
justify-content: center;
}
}
.bg-multicolumn-content-page-content{
background-color: unset !important;
}
.bg-multicolumn-content-page-content .grid-container{
gap: .5rem;
}
