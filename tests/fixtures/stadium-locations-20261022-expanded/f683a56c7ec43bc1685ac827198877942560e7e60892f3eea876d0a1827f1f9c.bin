/*** ALTERAÇÕES WEBSITE 08-09-2026 ****/

/* HEADER */
#masthead,
#masthead.header.-sticky,
.header.-mobile,
.header.-mobile .nav,
.header.-mobile .nav .mbl-overlay-container {
    background: #ffffff !important;
    background-color: #ffffff !important;
}

/* Texto e links do header */
#masthead,
#masthead a,
#masthead .menu > li > a,
#masthead .menu-optional > li > a,
#masthead .branding,
#masthead .cart-total,
.header.-mobile .nav .nav-item a {
    color: #111111 !important;
}

/* Ícones do header */
#masthead .ion,
#masthead svg,
#masthead svg * {
    color: #111111 !important;
    fill: #111111 !important;
    stroke: #111111 !important;
}


/* FOOTER */
.site-footer,
.site-footer .page-container,
.site-footer .widgets {
    background: #ffffff !important;
    background-color: #ffffff !important;
}

/* Texto e links do footer */
.site-footer,
.site-footer p,
.site-footer span,
.site-footer h1,
.site-footer h2,
.site-footer h3,
.site-footer h4,
.site-footer h5,
.site-footer h6,
.site-footer a,
.site-footer .widgets a,
.site-footer .widget-title,
.site-footer .site-info {
    color: #111111 !important;
}

/* Ícones do footer */
.site-footer .ion,
.site-footer svg,
.site-footer svg * {
    color: #111111 !important;
    fill: #111111 !important;
    stroke: #111111 !important;
}


.site-content {
    background-color: #ffffff !important;
    background-image: url('https://loja.vitoriasc.pt/wp-content/uploads/2022/01/padroes_vsc-02.jpg');
    background-repeat: repeat;
    background-position: top left;
    background-size: auto;
}

/* =========================================
   CONTEÚDO ABAIXO DO HEADER
   ========================================= */

/* =========================================
   HEADER NORMAL NO FLUXO DA PÁGINA
   ========================================= */

/* Estado inicial: header ocupa espaço real */
#masthead.header:not(.-sticky) {
    position: relative !important;
    top: auto !important;
    left: auto !important;
    right: auto !important;
    width: 100% !important;
    transform: none !important;
}

/* O conteúdo começa naturalmente abaixo */
.site-content {
    padding-top: 0 !important;
}


/* =========================================
   HEADER STICKY APÓS SCROLL
   ========================================= */

#masthead.header.-sticky {
    position: fixed !important;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 9999;
}

.page-container.top-offset {
    padding-top: 0 !important;
}

.socialbar .social {
    background: #ffd700 !important;
    border-color: #ffd700 !important;
    color: #000 !important;
}

.socialbar .social i {
    color: #000 !important;
}

.socialbar .social svg,
.socialbar .social svg * {
    fill: #000 !important;
    stroke: #000 !important;
}

.socialbar .social:hover {
    background: #ffd700 !important;
    border-color: #ffd700 !important;
    color: #000 !important;
    transform: none !important;
    opacity: 1 !important;
}

.socialbar .social:hover i {
    color: #000 !important;
}

.socialbar .social:hover svg,
.socialbar .social:hover svg * {
    fill: #000 !important;
    stroke: #000 !important;
}

.clb-scroll-top-bar,
.clb-scroll-top-bar .scroll-track {
    background-color: #ffd700 !important;
}

.clb-scroll-top-holder {
    color: #ffd700 !important;
}

.single-post .clb-page-headline.without-cap{
	padding-top:0;
}

.tabela_patrocinadores_mobile td{
	border:none;
}

/* =========================================================
   FIX LIMPO - TIMELINE VITÓRIA SC
   Não mexe na estrutura/posicionamento do widget
   ========================================================= */

/* TÍTULOS */
.twae-horizontal-timeline .twae-label-big {
    width: 100% !important;
    max-width: 100% !important;

    white-space: normal !important;
    word-break: normal !important;
    overflow-wrap: break-word !important;

    overflow: visible !important;

    font-size: 15px !important;
    line-height: 1.15 !important;
    font-weight: 600 !important;

    text-align: center !important;

    margin: 0 !important;
    padding: 0 8px !important;

    box-sizing: border-box !important;
}


/* ANO */
.twae-horizontal-timeline .twae-label-small {
    display: block !important;

    width: 100% !important;

    font-size: 12px !important;
    line-height: 1 !important;

    text-align: center !important;

    margin-top: 4px !important;
    margin-bottom: 6px !important;

    padding: 0 !important;

    position: relative !important;
    top: -4px !important;
}


/* ÁREA DOS LABELS */
.twae-horizontal-timeline .twae-labels {
    width: 100% !important;
    max-width: 100% !important;

    text-align: center !important;

    padding: 0 !important;

    overflow: visible !important;

    box-sizing: border-box !important;
}


/* EVITA TÍTULOS A INVADIREM OUTROS SLIDES */
.twae-horizontal-timeline .twae-story {
    box-sizing: border-box !important;
}

.twae-horizontal-timeline .twae-story .twae-labels {
    max-width: 100% !important;
}


/* DESKTOP */
@media (min-width: 1025px) {

    .twae-horizontal-timeline .twae-label-big {
        font-size: 15px !important;
        line-height: 1.15 !important;
    }

    .twae-horizontal-timeline .twae-label-small {
        font-size: 12px !important;
        top: -4px !important;
    }

}


/* TABLET */
@media (min-width: 768px) and (max-width: 1024px) {

    .twae-horizontal-timeline .twae-label-big {
        font-size: 14px !important;
        line-height: 1.15 !important;
    }

    .twae-horizontal-timeline .twae-label-small {
        font-size: 11px !important;
        top: -3px !important;
    }

}


/* MOBILE */
@media (max-width: 767px) {

    .twae-horizontal-timeline .twae-label-big {
        font-size: 13px !important;
        line-height: 1.15 !important;
    }

    .twae-horizontal-timeline .twae-label-small {
        font-size: 11px !important;
        top: -2px !important;
    }

}

input[type="submit"]{
	background:#ffd700 !important;
	border:none;
}

.wpcf7 form .wpcf7-response-output{
	border-color: #000000 !important;
    color: #000000 !important;
}





/* =========================================
   FORMULÁRIO MODALIDADES
========================================= */

.modalidades-form {
    color: #fff !important;
}


/* LABELS */

.modalidades-form label,
.modalidades-form use_label_element {
    color: #fff !important;
    font-weight: 600 !important;
    line-height: 1.4 !important;
}


/* WRAPPER DOS CAMPOS */

.modalidades-form .wpcf7-form-control-wrap {
    display: block !important;
    width: 100% !important;
    margin-top: 7px !important;
}


/* CAMPOS */

.modalidades-form input[type="text"],
.modalidades-form input[type="password"],
.modalidades-form input[type="number"],
.modalidades-form input[type="email"],
.modalidades-form input[type="tel"],
.modalidades-form input[type="date"],
.modalidades-form select,
.modalidades-form textarea {
    color: #fff !important;
    -webkit-text-fill-color: #fff !important;

    background-color: transparent !important;

    border: 1px solid #777 !important;
    border-radius: 5px !important;

    width: 100% !important;

    padding: 12px 14px !important;

    line-height: 1.3 !important;

    box-sizing: border-box !important;

    outline: none !important;

    box-shadow: none !important;
}


/* PLACEHOLDERS */

.modalidades-form input::placeholder,
.modalidades-form textarea::placeholder {
    color: #aaa !important;
    -webkit-text-fill-color: #aaa !important;
    opacity: 1 !important;
}


/* SELECTS */

.modalidades-form select {
    color: #fff !important;
    -webkit-text-fill-color: #fff !important;

    background-color: transparent !important;

    padding-left: 14px !important;
    padding-right: 40px !important;

    cursor: pointer !important;
}

.modalidades-form select option {
    color: #000 !important;
    background: #fff !important;
}


/* DATE */

.modalidades-form input[type="date"] {
    color-scheme: dark !important;
}


/* FOCUS */

.modalidades-form input:focus,
.modalidades-form select:focus,
.modalidades-form textarea:focus {
    border-color: #fff !important;
}


/* ESPAÇO ENTRE CAMPOS */

.modalidades-form .vc_col-lg-6,
.modalidades-form .vc_col-lg-12 {
    margin-bottom: 18px !important;
}


/* TÍTULOS DAS SECÇÕES */

.modalidades-form strong span {
    color: #fff !important;
    font-weight: 700 !important;
}


/* LINKS */

.modalidades-form a {
    color: #fff !important;
}

.modalidades-form a:hover {
    opacity: 0.8;
}


/* CHECKBOX */

.modalidades-form input[type="checkbox"] {
    width: auto !important;
    min-height: auto !important;
    margin-right: 6px !important;
}


/* BOTÃO */

.modalidades-form button,
.modalidades-form input[type="submit"] {
    background: #ffda06 !important;
    color: #000 !important;
    -webkit-text-fill-color: #000 !important;

    border: none !important;
    border-radius: 4px !important;

    padding: 12px 22px !important;

    font-weight: 700 !important;
}


/* MOBILE */

@media (max-width: 767px) {

    .modalidades-form input[type="text"],
    .modalidades-form input[type="password"],
    .modalidades-form input[type="number"],
    .modalidades-form input[type="email"],
    .modalidades-form input[type="tel"],
    .modalidades-form input[type="date"],
    .modalidades-form select,
    .modalidades-form textarea {
        font-size: 16px !important;
    }

