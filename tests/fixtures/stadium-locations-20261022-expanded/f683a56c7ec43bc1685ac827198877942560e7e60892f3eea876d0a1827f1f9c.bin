    align-self: end!important;
    bottom: 140px!important;
    position: relative!important;
}

.bdt-prime-slider-skin-general .bdt-slide-btn {
	    color: var(--e-global-color-4c29f92)!important;
    border-style: solid!important;
    border-color: var(--e-global-color-accent)!important;
	border: 2px solid var(--e-global-color-accent)!important;
}

.bdt-prime-slider-skin-general .bdt-slide-btn .bdt-slide-btn-icon {
	background: var(--e-global-color-accent)!important;
}

.bdt-prime-slider-skin-general .bdt-slide-btn .bdt-slide-btn-icon svg * {
	stroke: #000000!important;
}


.wpcf7-form .disp-matriz {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
}
.wpcf7-form .disp-matriz th,
.wpcf7-form .disp-matriz td {
  border: 2px solid #000;
  padding: 12px;
  text-align: center;
  background: #000;
  color: #fff;
}
.wpcf7-form .disp-matriz thead th {
  font-weight: 700;
}
.wpcf7-form .disp-matriz tbody th {
  text-align: left;
  white-space: nowrap;
}

.wpcf7-form .disp-box .wpcf7-list-item-label {
  position: absolute;
  clip: rect(1px,1px,1px,1px);
}

/* Tamanho da checkbox */
.wpcf7-form .disp-box input[type="checkbox"] {
  width: 22px;
  height: 22px;
  cursor: pointer;
}

.wpcf7-form .disp-matriz tbody tr:nth-child(even) th,
.wpcf7-form .disp-matriz tbody tr:nth-child(even) td {
  background: #111;
}

/* ALTERAR MENU LOJA PARA COR AMARELA */
.menuloja a{
	color:#ffd700 !important;
	font-weight:700 !important;
}

@media only screen and (min-width: 1024px) {
    #popmake-85348.pum-container.pum-responsive.pum-responsive-normal {
        margin: 0 auto;
        width: auto;
    }
}
#popmake-85348{
	background:none;
}


/*** CONTACT FORM ****/
.form-inscricao-jovem {
  width: 100%;
}

/* Remove os <br> automáticos que o Contact Form 7 está a inserir */
.form-inscricao-jovem br {
  display: none !important;
}

.form-inscricao-jovem p {
  margin: 0 !important;
  padding: 0 !important;
}

.form-inscricao-jovem h3 {
  margin: 34px 0 18px 0;
  font-size: 22px;
  font-weight: 700;
  line-height: 1.2;
}

.form-inscricao-jovem h3:first-child {
  margin-top: 0;
}

.form-inscricao-jovem .form-row {
  margin-bottom: 20px;
}

.form-inscricao-jovem .form-row > label {
  display: block;
  margin: 0 0 8px 0 !important;
  padding: 0 !important;
  font-weight: 600;
  line-height: 1.3;
}

.form-inscricao-jovem .wpcf7-form-control-wrap {
  display: block;
  margin: 0 !important;
  padding: 0 !important;
}

.form-inscricao-jovem input[type="text"],
.form-inscricao-jovem input[type="email"],
.form-inscricao-jovem input[type="tel"],
.form-inscricao-jovem input[type="date"],
.form-inscricao-jovem input[type="number"],
.form-inscricao-jovem textarea,
.form-inscricao-jovem select {
  display: block;
  width: 100%;
  box-sizing: border-box;
  margin: 0 !important;
}

.form-inscricao-jovem textarea {
  min-height: 120px;
}

.form-inscricao-jovem .wpcf7-radio,
.form-inscricao-jovem .wpcf7-checkbox {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 22px;
  margin: 0 !important;
  padding: 0 !important;
}

.form-inscricao-jovem .wpcf7-list-item {
  margin: 0 !important;
}

.form-inscricao-jovem .wpcf7-list-item label {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin: 0 !important;
  font-weight: 400;
}

.form-inscricao-jovem .wpcf7-list-item input {
  margin: 0 !important;
}

.form-inscricao-jovem .form-note {
  margin: -6px 0 20px 0;
  font-size: 14px;
  line-height: 1.4;
  opacity: 0.85;
}

.form-inscricao-jovem .form-submit {
  margin-top: 26px;
}

.form-inscricao-jovem input[type="submit"] {
  cursor: pointer;
}


