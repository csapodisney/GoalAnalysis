<script type = "text/javascript">
    function GetCode(callback) {
        var keyValue = "";
        $.ajax({
            type: "GET",
            url: "https://ili.ksc.de/?eID=SkyTicketController%3A%3AGetSkyTicketCode",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                keyValue = response.data;
                callback(keyValue);
            },
            failure: function (response) {
                console.log(response);
            }
        });
        return keyValue;
    }
    
</script>
<script type = "text/javascript">

    function UpdateCode(number) {
        $.ajax({
            type: "post",
            data: {code: number},
            url: "https://ili.ksc.de/?eID=SkyTicketController%3A%3AUpdateSkyTicketCode",
            enctype: "multipart/form-data",
            success: function (response) {
                console.log(response.data);
            },
            failure: function (response) {
                console.log(response);
            }
        });
    }

if (document.getElementById("skyticket-btn")) {
document.getElementById("skyticket-btn").onclick = function(e) {
    e.preventDefault();
    GetCode(function(code) {
        var url = document.getElementById("skyticket-btn").href;
        //processing the data
        var new_url = updateQueryStringParameter(url, 'voucherin', code);
        document.getElementById("skyticket-btn").href=new_url;
        UpdateCode(code);
        window.open(new_url);
    });

    
  };
}


  function updateQueryStringParameter(uri, key, value) {
      var re = new RegExp("([?&])" + key + "=.*?(&|$)", "i");
      var separator = uri.indexOf('?') !== -1 ? "&" : "?";
      if (uri.match(re)) {
        return uri.replace(re, '$1' + key + "=" + value + '$2');
      } else {
        return uri + separator + key + "=" + value;
      }

  }

</script>


