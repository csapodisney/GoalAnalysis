45c8-b9fd-4babf383dfe9-449.png","height":170,"width":170,"thumbnails":{"xsmall":"https://statics-maker.llt-services.com/mga/images/2022/12/30/xsmall/d527247765e94e3458ddfde5dea35840.png","xlarge":"https://statics-maker.llt-services.com/mga/images/2022/12/30/xlarge/44f2ffc1835c7267da5fa3b7e0b75cf4.png"}},"imageHeroFootball":{"id":"c10a328f-62e3-450b-85ed-d2a06171f912","alt":null,"url":"https://statics-maker.llt-services.com/mga/images/2025/03/05/original/4f102a49-07df-4042-b3f1-426c1fdea719-19.jpg","height":900,"width":1900,"identifierProcessed":"4f102a49-07df-4042-b3f1-426c1fdea719-19","isImageProcessed":true,"thumbnails":{"xsmall":"https://statics-maker.llt-services.com/mga/images/2025/03/05/xsmall/4f102a49-07df-4042-b3f1-426c1fdea719-19.jpg","xlarge":"https://statics-maker.llt-services.com/mga/images/2025/03/05/xlarge/4f102a49-07df-4042-b3f1-426c1fdea719-19.jpg"}},"imageWebclip":{"id":"2103671e-0b60-4942-b5fa-fc16a111ee55","alt":null,"url":"https://statics-maker.llt-services.com/mga/images/2022/12/30/watermarked/a1b0798a-bbb5-45c8-b9fd-4babf383dfe9-449.png","height":170,"width":170,"thumbnails":{"xsmall":"https://statics-maker.llt-services.com/mga/images/2022/12/30/xsmall/d527247765e94e3458ddfde5dea35840.png","xlarge":"https://statics-maker.llt-services.com/mga/images/2022/12/30/xlarge/44f2ffc1835c7267da5fa3b7e0b75cf4.png"}},"overlayHeroFootball":false},"interests":{"active":false},"ticketing":{"title":"Comprar entradas"},"reactions":{"content":null,"exclusive":{"message":{"subtitle":null,"title":null},"status":false},"status":false},"segmentation":{"subtitle":"Regístrate o inicia sesión para participar ","title":"Sorteo exclusivo para usuarios registrados"},"units":{"currency":"EUR","measurementSystem":"metric"}},"slug":"estadio-la-rosaleda","type":"PAGE_SINGLE","data":{"page":{"id":"cc823657-7055-4fb9-8c96-1a37879660f6","name":"Estadio La Rosaleda","seoTitle":"Estadio La Rosaleda","seoDescription":null,"seoMetatags":null,"slug":"estadio-la-rosaleda","exclusiveContent":false,"config":{"show_rrss":false,"hide_title":false},"type":"with_modules","subtype":"none","accessControl":{"status":"public","accessControlTitle":null,"accessControlSubtitle":null,"accessControlExpirationDate":null,"accessControlActiveAfterExpired":false,"accessControlExpirationMessage":null},"topMenu":{"enabled":false,"topMenuLogo":null,"topMenuLogoPosition":"none","topMenuBackground":"none","topMenuBackgroundColor":null,"topMenuButton":false,"topMenuButtonTitle":null,"topMenuButtonPageLink":null,"topMenuButtonType":"none","topMenuButtonAccessibleText":null},"image":null,"branding":"72b09aec-bc6c-4475-8f64-60cd38d6a6fe","grids":[{"id":"9f854108-3750-452c-8564-3e45afb7b17b","type":"no_division","config":{"name":null,"paddingTop":0,"paddingBottom":5},"areas":[{"modules":[{"id":"f282a350-bc84-4617-adea-ed5efec43dc8","type":"script","content":"\u003cstyle\u003e\n/* Ocultar la barra de Titulo de la página */\n.MkTitleBar {\n display:none !important;\n}\n\u003c/style\u003e\n\n\u003cimg width=\"1892\" height=\"423\" src= \"https://statics-maker.llt-services.com/mga/images/2023/03/30/optimized/463d02d8-4cb2-4a44-ae9a-03de2371bd4f-985.jpg\"\u003e","config":null}]}]},{"id":"b6b873ca-1b58-4499-bbef-c7ce46ae73e8","type":"right_sidebar","config":{"name":null,"paddingTop":10,"paddingBottom":30},"areas":[{"modules":[{"id":"b8849a7c-80f6-4d39-a25e-66351ce46188","type":"text","content":"\u003cp style=\"text-align: justify;\"\u003eEl Estadio La Rosaleda, situado en el Paseo de Martiricos, es la casa del fútbol en Málaga desde que se inaugurara de manera oficial el 14 de septiembre de 1941 en un partido entre el CD Málaga y el Sevilla FC. La pequeña Lourdes Alonso de 10 años, hija del entonces alcalde malacitano Pedro Luis Alonso, fue la encargada de realizar el saque de honor en aquel encuentro y el sevillista Torrontegui ostenta el honor de haber logrado el primer gol del nuevo estadio, tras batir al portero malaguista Navés. El resultado final del envite, 3-2 favorable al Málaga.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eUn 13 de abril de 1941, con el partido CD Malacitano-AD Ferroviaria correspondiente a la Copa del Generalísimo, se jugó el primer encuentro de fútbol en un Estadio La Rosaleda aún en fase de construcción. El resultado fue de 6-0 a favor costasoleño, con un gran protagonista: Manuel Fuentes Campesino, autor de cinco de los goles y del primero en la historia del recinto blanquiazul.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eLa mayor goleada vista en La Rosaleda fue el mítico 14-0 que endosó el Málaga CF al Garrucha en la 40ª jornada del Grupo IX de Tercera División (07/05/1995). Como CD Málaga, fue un 11-4 al Toledo (18/04/1948) en la sexta ronda de la Copa del Generalísimo, partido donde más goles (15) se ha marcado en la historia de la Copa de España. Pedro Bazán, en el famoso 9-2 al Hércules en Segunda División (04/01/1948), es el jugador que más goles (9) anotó en un partido en Martiricos y el máximo realizador en el recinto blanquiazul (103 goles).\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eEl carismático Basti, con 40 tantos, es el mejor goleador en casa en la historia del Málaga CF. Migueli, emblema del CD Málaga, es el futbolista con más partidos jugados en La Rosaleda (234).\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eLa Rosaleda ha albergado en sus más de 80 años de vida partidos de Liga, Copa del Rey, Intertoto, Copa de la UEFA y UEFA Champions League, once compromisos de la Selección Española masculina y dos de la femenina (ambos de Women's Nations League), y tres encuentros de la fase de grupos de la Copa del Mundo celebrada en España (1982) con las selecciones de Escocia, Nueva Zelanda y la extinta Unión Soviética.\u003c/p\u003e\n\u003cp style=\"text-align: justify;\"\u003eHistoria en piedra del fútbol en Málaga que el estadio de Martiricos ha honrado en los últimos años renombrando las puertas del campo con mitos del Club como Migueli, Viberti, Benítez, Bazán, Gallardo, Andrés Perales o Abdullah Ben Barek.\u003c/p\u003e","config":null},{"id":"5ba927f8-9458-444a-b9c8-14ed4368a4a6","type":"script","content":"\u003chtml\u003e\r\n\u003chead\u003e\r\n\t\u003cstyle\u003e\r\n\t\t.columnas {\r\n\t\t\tdisplay: flex;\r\n\t\t\tflex-direction: row;\r\n\t\t\tjustify-content: space-between;\r\n\t\t\talign-items: stretch;\r\n\t\t\tflex-wrap: wrap;\r\n\t\t}\r\n\t\t\r\n\t\t.columna {\r\n\t\t\tflex-basis: 50%;\r\n\t\t\tpadding: 10px;\r\n\t\t\tmargin-bottom: 20px;\r\n\t\t\tbackground-color: #F7F9F9;\r\n\t\t}\r\n\t\u003c/style\u003e\r\n\u003c/head\u003e\r\n\u003cbody\u003e\r\n\t\u003cdiv class=\"columnas\"\u003e\r\n\t\t\u003cdiv class=\"columna\"\u003e\r\n\t\t\t\u003ch6 class=\"mod-title \" style=\"color:#ffffff;background:#4190de;padding-left:15px;\"\u003e\u003cspan\u003e\u003cspan\u003e\u003cstrong\u003eMCF / \u003c/strong\u003eMUSEO \u0026 TOUR MÁLAGA CF\u003c/span\u003e\u003c/span\u003e\u003c/h6\u003e\r\n\t\t\t\u003ca href=\"/museo\" target=\"_blank\"\u003e\r\n\t\t\t    \u003cimg src=\"https://statics-maker.llt-services.com/mga/images/2025/09/19/original/b523777a-6c2d-4287-afd9-9e67c20cdf55-799.jpg\"  align=\"left\"/\u003e\r\n\t\t\t\u003c/a\u003e\r\n\t\t\u003c/div\u003e\r\n\t\t\u003cdiv class=\"columna\"\u003e\r\n\t\t    \u003ch6 class=\"mod-title \" style=\"color:#ffffff;background:#4190de;padding-left:15px;\"\u003e\u003cspan\u003e\u003cspan\u003e\u003cstrong\u003eMCF / \u003c/strong\u003eESTADIO LA ROSALEDA\u003c/span\u003e\u003c/span\u003e\u003c/h6\u003e\r\n\t\t    \u003ca href=\"/galerias/la-rosaleda\" target=\"_blank\"\u003e\r\n\t\t        \u003cimg src=\"https://statics-maker.llt-services.com/mga/images/2023/03/28/optimized/f88247f5-a314-4013-81d1-fbbefcb193a7-44.jpg\"  align=\"right\"/\u003e\r\n\t\t    \u003c/a\u003e\t\r\n\t\t\u003c/div\u003e\r\n\t\u003c/div\u003e\r\n\u003c/body\u003e\r\n\u003c/html\u003e\r\n","config":null}]},{"modules":[{"id":"5577662c-7c0d-4d31-80c8-5d2064909df3","type":"script","content"