q5QE2LVnjLk67EQnMmrP 640w, /_next/image?url=%2Fbrand%2Fclub%2Fstade-panorama.jpg&amp;w=750&amp;q=75&amp;dpl=dpl_4SvoxLsfq5QE2LVnjLk67EQnMmrP 750w, /_next/image?url=%2Fbrand%2Fclub%2Fstade-panorama.jpg&amp;w=828&amp;q=75&amp;dpl=dpl_4SvoxLsfq5QE2LVnjLk67EQnMmrP 828w, /_next/image?url=%2Fbrand%2Fclub%2Fstade-panorama.jpg&amp;w=1080&amp;q=75&amp;dpl=dpl_4SvoxLsfq5QE2LVnjLk67EQnMmrP 1080w, /_next/image?url=%2Fbrand%2Fclub%2Fstade-panorama.jpg&amp;w=1200&amp;q=75&amp;dpl=dpl_4SvoxLsfq5QE2LVnjLk67EQnMmrP 1200w, /_next/image?url=%2Fbrand%2Fclub%2Fstade-panorama.jpg&amp;w=1920&amp;q=75&amp;dpl=dpl_4SvoxLsfq5QE2LVnjLk67EQnMmrP 1920w, /_next/image?url=%2Fbrand%2Fclub%2Fstade-panorama.jpg&amp;w=2048&amp;q=75&amp;dpl=dpl_4SvoxLsfq5QE2LVnjLk67EQnMmrP 2048w, /_next/image?url=%2Fbrand%2Fclub%2Fstade-panorama.jpg&amp;w=3840&amp;q=75&amp;dpl=dpl_4SvoxLsfq5QE2LVnjLk67EQnMmrP 3840w" src="/_next/image?url=%2Fbrand%2Fclub%2Fstade-panorama.jpg&amp;w=3840&amp;q=75&amp;dpl=dpl_4SvoxLsfq5QE2LVnjLk67EQnMmrP"/></div><div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]"><section aria-labelledby="stade" class="rounded-lg border border-black/10 bg-white shadow-[0_6px_24px_rgba(4,9,29,0.07)] px-6 py-10 sm:px-10"><h2 id="stade" class="text-graphite font-serif uppercase text-center text-4xl sm:text-5xl">Le Nouste Camp</h2><div class="mt-6 space-y-5 text-base leading-relaxed sm:text-justify sm:hyphens-auto"><p>Depuis le <strong class="font-bold hyphens-none">14 septembre 2018</strong>, le <strong class="font-bold hyphens-none">Nouste Camp</strong> est le stade du <strong class="font-bold hyphens-none">Pau Football Club</strong>. Conçu dans l&#x27;esprit des <strong class="font-bold hyphens-none">enceintes anglaises</strong>, il offre une proximité <strong class="font-bold hyphens-none">exceptionnelle</strong> entre le terrain et les <strong class="font-bold hyphens-none">supporters</strong>, créant une <strong class="font-bold hyphens-none">ambiance unique</strong> où chaque rencontre se vit avec <strong class="font-bold hyphens-none">intensité</strong>.</p><p>Résidence du <strong class="font-bold hyphens-none">Pau FC en Ligue 2 BKT</strong>, le Nouste Camp accueille tout au long de la saison les rencontres du championnat professionnel français, offrant un <strong class="font-bold hyphens-none">cadre moderne</strong> et convivial aux <strong class="font-bold hyphens-none">passionnés de football</strong> comme <strong class="font-bold hyphens-none">aux partenaires du club</strong>.</p></div></section><section aria-label="Le Nouste Camp en chiffres" class="from-navy-700 to-navy-950 flex items-center rounded-lg bg-gradient-to-b px-6 py-10 text-white shadow-[0_6px_16px_rgba(4,9,29,0.25)] sm:px-8"><dl class="w-full space-y-8"><div class="flex items-center gap-4 sm:gap-5"><dt class="order-last text-sm leading-tight font-light sm:text-base">Places<br/>assises</dt><dd class="flex items-center gap-4 sm:gap-5"><span class="text-yellow shrink-0"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="h-12 w-12 sm:h-14 sm:w-14" aria-hidden="true"><g><rect x="6" y="6" width="12" height="15" rx="3"></rect><path d="M4 25h16M8 25v5M16 25v5"></path><rect x="6" y="34" width="12" height="15" rx="3"></rect><path d="M4 53h16M8 53v5M16 53v5"></path></g><g><rect x="26" y="6" width="12" height="15" rx="3"></rect><path d="M24 25h16M28 25v5M36 25v5"></path><rect x="26" y="34" width="12" height="15" rx="3"></rect><path d="M24 53h16M28 53v5M36 53v5"></path></g><g><rect x="46" y="6" width="12" height="15" rx="3"></rect><path d="M44 25h16M48 25v5M56 25v5"></path><rect x="46" y="34" width="12" height="15" rx="3"></rect><path d="M44 53h16M48 53v5M56 53v5"></path></g></svg></span><span class="font-serif text-5xl leading-none lining-nums tabular-nums sm:text-6xl">4 120</span></dd></div><div class="flex items-center gap-4 sm:gap-5"><dt class="order-last text-sm leading-tight font-light sm:text-base">Places<br/>VIP</dt><dd class="flex items-center gap-4 sm:gap-5"><span class="text-yellow shrink-0"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="h-12 w-12 sm:h-14 sm:w-14" aria-hidden="true"><circle cx="32" cy="13" r="3"></circle><path d="M32 16v4M12 44a20 20 0 0 1 40 0M6 44h52M10 50h44M22 32a12 12 0 0 1 8-6"></path></svg></span><span class="font-serif text-5xl leading-none lining-nums tabular-nums sm:text-6xl">600</span></dd></div><div class="flex items-center gap-4 sm:gap-5"><dt class="order-last text-sm leading-tight font-light sm:text-base">Affluence<br/>moyenne</dt><dd class="flex items-center gap-4 sm:gap-5"><span class="text-yellow shrink-0"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="h-12 w-12 sm:h-14 sm:w-14" aria-hidden="true"><circle cx="16" cy="18" r="6"></circle><circle cx="48" cy="18" r="6"></circle><circle cx="32" cy="14" r="7"></circle><path d="M4 42c0-7 5-12 12-12 3 0 6 1 8 3M60 42c0-7-5-12-12-12-3 0-6 1-8 3M20 44c0-8 5-14 12-14s12 6 12 14M4 50h56M8 56h48"></path></svg></span><span class="font-serif text-5xl leading-none lining-nums tabular-nums sm:text-6xl">92<span class="ml-0.5 text-3xl">%</span></span></dd></div></dl></section></div><section aria-labelledby="plan" class="mt-16 lg:mt-20"><h2 id="plan" class="text-graphite font-serif uppercase text-5xl leading-[0.95] sm:text-6xl">Plan du stade</h2><div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]"><div class="grid grid-cols-2 gap-4 lg:grid-cols-1 lg:grid-rows-2 lg:gap-6"><div class="relative aspect-[4/3] overflow-hidden rounded-lg shadow-[0_6px_18px_rgba(4,9,29,0.12)] lg:aspect-auto lg:min-h-40"><img alt="La tribune Holy du Nouste Camp illuminée un soir de match" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0