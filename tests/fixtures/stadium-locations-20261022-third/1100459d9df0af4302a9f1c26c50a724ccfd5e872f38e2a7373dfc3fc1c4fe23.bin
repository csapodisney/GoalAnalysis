}.list-match .box-content:has(a[href*="/match/preparation-eag-"]){
  position:relative;
  z-index:0;
  background-color:rgba(255,0,0,.15);   /* 👈 ROUGE : 0.05 à 0.20 */
}/* ===================================================== */
/*  1) CARTES MATCHS AMICAUX (préparation)               */
/* ===================================================== */
.list-match .box-content:has(a[href*="/match/preparation-eag-"]){
  position:relative; z-index:0; overflow:hidden;
  background-color:#ededed;
  border-top:3px solid #9a9a9a;
  border-radius:10px;
  box-shadow:0 5px 16px rgba(0,0,0,.10);
}
.list-match .box-content:has(a[href*="/match/preparation-eag-"]) > *{
  position:relative; z-index:2;
}
.list-match .box-content:has(a[href*="/match/preparation-eag-"])::before{
  content:""; position:absolute; inset:0; z-index:1;
  background:url('https://www.eaguingamp.com/voy_content/uploads/2023/04/amd01174-2-scaled.jpg') center/cover no-repeat;
  opacity:.10; pointer-events:none;
}
.list-match .box-content:has(a[href*="/match/preparation-eag-"])::after{
  content:"PRÉPARATION 26-27";
  position:absolute; top:10px; right:10px; z-index:3;
  background:#555; color:#fff;
  font-size:10px; font-weight:800; letter-spacing:.5px;
  padding:3px 10px; border-radius:999px;
  box-shadow:0 2px 6px rgba(0,0,0,.25);
  pointer-events:none;
}
.list-match .box-content:has(a[href*="/match/preparation-eag-"]) .championnat span{
  color:#555; font-weight:700;
}

/* ===================================================== */
/*  2) CARTES LIGUE 2 : logo L2 au-dessus de "journée"    */
/* ===================================================== */
.list-match .box-content:has(a[href*="ligue-2-bkt"]){
  position:relative; z-index:0; overflow:hidden;
}
.list-match .box-content:has(a[href*="ligue-2-bkt"]) > *{
  position:relative; z-index:2;
}
.list-match .box-content:has(a[href*="ligue-2-bkt"])::before{
  content:""; position:absolute; inset:0; z-index:1;
  background:url('https://www.eaguingamp.com/voy_content/uploads/2025/11/logo_ligue_2_bkt_2024.svg-1.png') no-repeat center 62%;
  background-size:17%;
  opacity:1;
  pointer-events:none;
}		</style>
