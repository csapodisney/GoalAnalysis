  <style>
    :root{ --eag-red:#E20613; }

    .related-player{
      margin:2rem 0 0;
      /* pas de fond, pas de bordures */
    }
    .related-player-list{
      display:flex; flex-wrap:wrap; gap:16px;
    }
    .related-player-card{
      position:relative;
      display:flex; align-items:center; gap:24px;
      width:100%;
      padding:18px 20px;
      text-decoration:none; color:inherit;
      background:transparent; /* no grey */
    }
	  
	  /* Conteneur photo : pas de fond */
.related-player-photo{
  flex:0 0 auto;
  height:165px;
  background:transparent;   /* ⬅️ plus de fond noir */
  overflow:hidden;
  position:relative;
}

/* L'image passe au-dessus du numéro */
.related-player-photo img{
  width:100%; height:100%; object-fit:cover; display:block;
  position:relative; z-index:1;   /* ⬅️ au-dessus */
}

/* Numéro géant DERRIÈRE l'image (watermark) */
.related-player-photo .related-player-num-bg{
  position:absolute;
  top:25%; left:54%;
  transform:translate(-50%,-50%);
  z-index:0;                    /* ⬅️ derrière l'image */
  font-size:100px; line-height:1; font-weight: 1000;
  color:var(--eag-red);
  font-family: 'Oswald';
  letter-spacing: 8px;
  pointer-events:none; user-select:none;
  white-space:nowrap;
}


    /* Infos */
    .related-player-infos{
      display:flex; flex-direction:column; gap:4px;
      position:relative; z-index:1; margin-top: -20px !important; /* au dessus du numéro bg */
    }
    .related-player-name{
      margin:0;
      font-size:28px; letter-spacing:.2px;
    }
    .related-player-poste{
      opacity:.85;
    }
    .related-player-cta{
      margin-top:.25rem;
      color:var(--eag-red);
    }

    /* Mobile tweaks */
    @media (max-width:640px){
  .related-player-photo{ height:120px; }
  .related-player-photo .related-player-num-bg{ font-size:84px; font-weight: 1000;} /* centré, juste plus petit */
}
  /* centré, juste plus petit */
  .related-player-num-bg{font-size:84px;}
}
  </style>
