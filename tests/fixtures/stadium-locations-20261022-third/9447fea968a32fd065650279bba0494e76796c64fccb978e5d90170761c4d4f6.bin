3/address /--\u003E\n\u003C!-- /wp:wp-etourisme-v3/section-body --\u003E\n\u003C!-- /wp:wp-etourisme-v3/section --\u003E\n\n\u003C!-- wp:iris-collection-etourisme/communication {\"fields\":[{\"label\":\"Mail\",\"value\":\"mail\"},{\"label\":\"Page Facebook\",\"value\":\"page-facebook\"},{\"label\":\"Site web (URL)\",\"value\":\"site-web-url\"},{\"label\":\"T\u00e9l\u00e9phone\",\"value\":\"telephone\"},{\"label\":\"Page Twitter\",\"value\":\"page-twitter\"},{\"label\":\"Instagram\",\"value\":\"instagram\"},{\"label\":\"Tripadvisor\",\"value\":\"tripadvisor\"},{\"label\":\"Youtube\",\"value\":\"youtube\"}]} /--\u003E\n\n\u003C!-- wp:wp-etourisme-v3/html {\"field\":{\"label\":\"Identifiant Tripadvisor\",\"value\":\"identifiant-tripadvisor\"},\"htmlContent\":\"\\u003cdiv class=\\u0022wpet-tripadvisor\\u0022\\u003e\\n\\u003cdiv id=\\u0022TA_cdsratingsonlywide341\\u0022 class=\\u0022TA_cdsratingsonlywide\\u0022\\u003e\\n    \\u003cul id=\\u0022qhPkcXhy\\u0022 class=\\u0022TA_links xozUurlhjp\\u0022\\u003e\\n        \\u003cli id=\\u0022TbFwcq7\\u0022 class=\\u00226UltqkQx4dV3\\u0022\\u003e\\n            \\u003ca target=\\u0022_blank\\u0022 href=\\u0022https://www.tripadvisor.fr/\\u0022\\u003e\\n                \\u003cimg src=\\u0022https://www.tripadvisor.fr/img/cdsi/img2/branding/tripadvisor_logo_transp_340x80-18034-2.png\\u0022 alt=\\u0022TripAdvisor\\u0022 /\\u003e\\n            \\u003c/a\\u003e\\n        \\u003c/li\\u003e\\n    \\u003c/ul\\u003e\\n\\u003c/div\\u003e \\n\\n\\u003c/div\\u003e\"} /--\u003E\n\u003C!-- /wp:wp-etourisme-v3/section-body --\u003E\n\u003C!-- /wp:wp-etourisme-v3/section --\u003E\n\u003C!-- /wp:wp-etourisme-v3/layout-zone --\u003E\n\u003C!-- /wp:wp-etourisme-v3/wrapper --\u003E\n\n\u003C!-- wp:wp-etourisme-v3/layout-zone {\"type\":\"footer\",\"class\":\"wpet-zone-footer\",\"label\":\"Contenu pied de page\"} --\u003E\n\u003C!-- wp:wp-etourisme-v3/cross-selling /--\u003E\n\u003C!-- /wp:wp-etourisme-v3/layout-zone --\u003E\n\u003C!-- /wp:wp-etourisme-v3/layout --\u003E","post_title":"Stade Marcel Picot","post_excerpt":"","post_status":"publish","comment_status":"open","ping_status":"closed","post_password":"","post_name":"stade-marcel-picot","to_ping":"","pinged":"","post_modified":"2025-11-21 17:46:58","post_modified_gmt":"2025-11-21 16:46:58","post_content_filtered":"","post_parent":0,"guid":"https://www.destination-nancy.com/patrimoine-culturel/stade-marcel-picot/","menu_order":0,"post_type":"patrimoine-culturel","post_mime_type":"","comment_count":"0","filter":"raw","wpetContext":true,"detailPageTemplateId":8952,"wpetFields":{"adresse-1":"90","adresse-1-suite":"Boulevard Jean Jaur\u00e8s","animaux-acceptes":"NON","code-postal":"54510","commune":"TOMBLAINE","conditions-visites":["Visite des ext\u00e9rieurs uniquement"],"date-de-modification":"2025-04-15T14:54:10.000Z","description-longue":"Avec plus de 20 000 places assises, des \u00e9quipements d\u00e9di\u00e9s \u00e0 la presse, des salons d'honneur, un Club House des supporters ou encore une \u00ab rue \u00bb conviviale am\u00e9nag\u00e9e sous la tribune Hazotte, le stade Marcel Picot, th\u00e9\u00e2tre des rencontres de l'AS Nancy-Lorraine, est une enceinte moderne d\u00e9volue au football implant\u00e9e sur le territoire \u00e0 enjeux des Plaines Rive Droite et d\u00e9sormais dot\u00e9e d'une pelouse synth\u00e9tique.\nAu pied de l'enceinte d'honneur, \u00ab Picot \u00bb propose \u00e9galement deux terrains annexes o\u00f9 \u00e9voluent la r\u00e9serve professionnelle de l'ASNL, les associations et les scolaires de l'agglom\u00e9ration.","groupes-acceptes":"OUI","identifiant":"737011371","latitude":"48.6957213","longitude":"6.211436","nom":"Stade Marcel Picot","periodes":[],"telephone":["03 54 50 21 50"],"type-secondaire":["Architecture civile"],"types":"Site - monument","types-equipement":"Site - Monument","geo":{"type":"Point","coordinates":[6.211436,48.695721300000002]},"photos":[{"nom":null,"legende":null,"copyright":null,"url":{"full":"https://cdn