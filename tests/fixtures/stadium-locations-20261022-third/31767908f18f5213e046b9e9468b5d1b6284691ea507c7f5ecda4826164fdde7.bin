    }

    .info_content .btn {
        font-size: .75em;
    }

    .info_content .match_date {
        color: var(--main-color);
        font-weight: 900;
        font-size: .75em;
    }

    .class {
        overflow-y: scroll;
        overflow-x: hidden;
        font-weight: 700;
        text-transform: uppercase;

    }

    .class .border-bottom {
        border-bottom-color: var(--main-color);
    }

    .bg_primary {
