		<tr valign="middle">
			<td style="width: 638px;" valign="middle"><strong>Southern German Championship Winner</strong></td>
			<td style="width: 664px;" valign="middle">1974</td>
		</tr>
		<tr class="greybox" valign="middle">
			<td style="width: 638px;" valign="middle"><strong>Bavarian Championship Winners</strong></td>
			<td style="width: 664px;" valign="middle">1948, 1966,&nbsp;1973, 1980, 1982, 1994, 2002</td>
		</tr>
		<tr valign="middle">
			<td style="width: 638px;" valign="middle"><strong>Swabian Cup Winners</strong></td>
			<td style="width: 664px;" valign="middle">1965, 1969, 1970, 1971, 1972, 1977, 1980, 1986, 1988, 1993, 1996, 1999, 2002</td>
