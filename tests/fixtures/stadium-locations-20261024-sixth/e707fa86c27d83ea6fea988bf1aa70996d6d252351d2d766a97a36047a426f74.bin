<style id="wp-custom-css">
.elementor-post-navigation .elementor-post-navigation__separator-wrapper {
    text-align: center;
    margin-left: 10px;
    margin-right: 20px;
}

body {
	margin:0px!important;
}

/*InstaFeed Button*/
#sb_instagram .sbi_load_btn .sbi_btn_text, #sb_instagram .sbi_load_btn .sbi_loader {
    color: white;
	  font-weight:600!important;
		font-family:"Montserrat"!important;
	  font-size:16px;
	  padding-left:15px;
	  padding-right:15px;
    border-radius: 2px !important;
}

#sb_instagram #sbi_load .sbi_load_btn, #sb_instagram .sbi_follow_btn a
Specificity: (2,1,0)
 {
    border: none;
    color: #fff;
    border-radius: 2px!important;
}

#sb_instagram #sbi_images {
    padding-bottom: 30px;
}

/*Anpassung Youtube Feed Button*/
#sb_youtube_sbyUCChzK2mLDUkLVTD6CIX1vA4.sb_youtube.sby_palette_custom .sby_footer .sby_load_btn {
    color: white;
	  font-weight:600!important;
		font-family:"Montserrat"!important;
	  font-size:16px;
	  padding-left:25px!important;
	  padding-right:25px!important;
    border-radius: 3px !important;
	  background-color:#ED1C24!important
}

/*Anpassungen Viktoria spielt*/

.match-card {
  display:grid;
  grid-template-columns:1fr auto 1fr;
  align-items:center;
  text-align:center;
  gap:20px;
  font-family:'Montserrat Alternates', sans-serif;
  padding:15px;
}

.team {
  display:flex;
  flex-direction:column;
  align-items:center;
}



.team-logo {
  width: 120px;
  max-height: 120px;
  object-fit: contain;
  border-radius: 8px;
  padding: 5px;
}

.team-name {
  padding-top: 15px;
	font-size:1.5em;
  font-weight:700;
}

@media (max-width: 768px) {
  .team-name {
    visibility: hidden;
  }
}

.match-info {
  display:flex;
  flex-direction:column;
  align-items:center;
}

.match-center {
  font-size:1.2em;
  font-weight:700;
}

.match-location {
  font-size:.9em;
  color:#555;
}

.match-competition {
  padding-top: 8px;
	font-size:.85em;
  color:#fff;   /* <- war vorher "color:#fffff;" (ungültig) */
  margin-top:4px;
}

.live-indicator {
  color:red;
  font-weight:700;
  margin-top:4px;
  animation: blink 1s step-start infinite;
}

@keyframes blink {
  50% { opacity:0; }
}

/**Anpassung Teamkarten -> im CSS des Widgets im Loop Template**/

@media (max-width: 600px) {
	.match-center {
		font-size: 0.8rem;
	}
	
	.team-logo {
		min-width: 65px;
	}
	
	.team-name {
		display: none;
	}
}


</style>
