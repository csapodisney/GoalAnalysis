<style>
  /* JOB-101202: stacked Stakeholders / Partners layout. Partner grid: 5 cols desktop, 3 tablet, 2 mobile. */
  .partners__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px;
  }
  .partners__grid-item {
    flex: 0 0 calc(20% - 12px);
    display: flex;
    justify-content: center;
  }
  /* Cap height so portrait logos (BrewDog) sit in line with the landscape ones. */
  .partners__grid .partners__logo img {
    max-height: 90px;
    width: auto;
  }
  @media only screen and (max-width: 1199px) {
    .partners__grid-item {
      flex-basis: calc(33.333% - 10px);
    }
  }
  @media only screen and (max-width: 767px) {
    .partners__grid-item {
      flex-basis: calc(50% - 8px);
    }
  }
  /* Space between the Stakeholders logos and the Partners heading (below 768px app.css already adds margin-top). */
  @media only screen and (min-width: 768px) {
    .partners__title--partners {
      margin-top: 80px;
    }
  }
  @media only screen and (min-width: 768px) and (max-width: 991px) {
    .partners__title--partners {
      margin-top: 50px;
    }
  }
</style>

