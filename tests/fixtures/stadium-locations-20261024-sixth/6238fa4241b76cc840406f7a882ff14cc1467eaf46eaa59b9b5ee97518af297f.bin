	<div class="wpb_text_column wpb_content_element " >
		<div class="wpb_wrapper">
			<ul class="grid grid-cols-2 col-gap-4 md:grid-cols-3">
<li><span class="text-xs uppercase md:text-sm font-titles">Inauguración</span><br />
<span class="block text-sm opacity-75">2020</span></li>
<li><span class="text-xs uppercase md:text-sm font-titles">Capacidad ESTADIO</span><br />
<span class="block text-sm opacity-75"> 4.000 espectadores</span></li>
<li><span class="text-xs uppercase md:text-sm font-titles">Dimensiones</span><br />
<span class="block text-sm opacity-75">263.030 m<sup>2 </sup> (Primera fase 150.000 m<sup>2 </sup>)</span></li>
<li><span class="text-xs uppercase md:text-sm font-titles">Dirección</span><br />
<span class="block text-sm opacity-75">Camiño do Monte, Mos</span></li>
</ul>

