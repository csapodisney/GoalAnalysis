<h2>BENVENUTI ALLO STADIO</h2>
<h1>RENATO DALL&#8217;ARA</h1>
<p>La Casa del Bologna Football Club 1909</p>
</div>
<span class="cp-load-after-post"></span><div class="essb-pinterest-pro-content-marker" style="display: none !important;"></div><section class="section img-opening">
      <div class="absolute-cont">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <span class="sopratitolo">BENVENUTI ALLO STADIO</span>            <h1>RENATO DALL’ARA</h1>
            <span class="sottotitolo">LA CASA DEL BOLOGNA FOOTBALL CLUB 1909</span>          </div>
        </div>
      </div>
    </div>
    <picture>
    <source media="(min-width: 650px)" srcset="https://www.bolognafc.it/wp-content/uploads/2024/07/bologna-fc-stadio-desktop.jpg">
        
