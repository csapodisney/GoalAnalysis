<script id="sparta-2026-header-scroll-js-after">
(() => {
            const headerMain = document.querySelector(".sparta-header-main");
            const redMenu = document.querySelector(".sparta-red-menu-bar");
            let redMenuStart = 0;
            const getHeaderOffset = () => headerMain?.getBoundingClientRect().height || 86;
            const getAdminBarOffset = () => document.getElementById("wpadminbar")?.getBoundingClientRect().height || 0;
            const shouldUseStickyRedMenu = () => redMenu && window.innerWidth > 1280;
            const lazyLoadHeaderVideo = () => {
                const video = document.querySelector(".sparta-header-video[data-src]");
                if (!video || video.dataset.loaded === "1") {
                    return;
                }
                const src = video.dataset.src;
                const source = video.querySelector("source");
                if (!src || !source) {
                    return;
                }
                video.dataset.loaded = "1";
                source.src = source.dataset.src || src;
                video.load();
                video.play?.().catch(() => {});
            };
            const scheduleHeaderVideoLoad = () => {
                if (!document.querySelector(".sparta-header-video[data-src]")) {
                    return;
                }
                const loadWhenVisible = () => {
                    if (document.visibilityState === "visible") {
                        if ("requestIdleCallback" in window) {
                            window.requestIdleCallback(lazyLoadHeaderVideo, { timeout: 1500 });
                        } else {
                            window.setTimeout(lazyLoadHeaderVideo, 1);
                        }
                        return;
                    }
                    document.addEventListener("visibilitychange", () => {
                        if (document.visibilityState === "visible") {
                            lazyLoadHeaderVideo();
                        }
                    }, { once: true });
                };
                if (document.readyState === "complete") {
                    loadWhenVisible();
                    return;
                }
                window.addEventListener("load", loadWhenVisible, { once: true });
            };
            const measureRedMenu = () => {
                if (!redMenu) {
                    return;
                }
                document.body.classList.remove("sparta-red-menu-sticky");
                redMenuStart = redMenu.getBoundingClientRect().top + window.scrollY;
            };
            const updateHeaderState = () => {
                document.body.classList.toggle("sparta-header-scrolled", window.scrollY > 80);
                if (!shouldUseStickyRedMenu()) {
                    document.body.classList.remove("sparta-red-menu-sticky");
                    return;
                }
                document.body.classList.toggle(
                    "sparta-red-menu-sticky",
                    window.scrollY + getHeaderOffset() + getAdminBarOffset() >= redMenuStart
                );
            };
            const toggle = document.querySelector(".sparta-mobile-menu-toggle");
            const panel = document.querySelector(".sparta-mobile-menu-panel");
            const closeMobileSubmenus = () => {
                panel?.querySelectorAll(".sparta-submenu-open").forEach((item) => {
                    item.classList.remove("sparta-submenu-open");
                    item.querySelector(":scope > .sparta-mobile-submenu-toggle")?.setAttribute("aria-expanded", "false");
                });
            };
            const setMobileMenuOpen = (open) => {
                document.body.classList.toggle("sparta-mobile-menu-open", open);
                toggle?.setAttribute("aria-expanded", open ? "true" : "false");
                if (!open) {
                    closeMobileSubmenus();
                }
            };
            const enhanceMobileSubmenus = () => {
                panel?.querySelectorAll(".sparta-main-menu .menu-item-has-children").forEach((item) => {
                    if (item.querySelector(":scope > .sparta-mobile-submenu-toggle")) {
                        return;
                    }
                    const link = item.querySelector(":scope > a");
                    const subMenu = item.querySelector(":scope > .sub-menu");
                    if (!link || !subMenu) {
                        return;
                    }
                    const button = document.createElement("button");
                    button.type = "button";
                    button.className = "sparta-mobile-submenu-toggle";
                    button.setAttribute("aria-expanded", "false");
                    button.setAttribute("aria-label", `${link.textContent.trim()} submenu`);
                    button.addEventListener("click", () => {
                        const isOpen = item.classList.toggle("sparta-submenu-open");
                        button.setAttribute("aria-expanded", isOpen ? "true" : "false");
                    });
                    link.insertAdjacentElement("afterend", button);
                });
            };
            const enhanceMainMenuNavigation = () => {
                const prefetchedUrls = new Set();
                const canPrefetch = (link) => {
                    if (!link || link.target || link.hasAttribute("download")) {
                        return false;
                    }
                    const url = new URL(link.href, window.location.href);
                    return url.origin === window.location.origin && url.pathname !== window.location.pathname;
                };
                const prefetch = (link) => {
                    if (!canPrefetch(link)) {
                        return;
                    }
                    const url = new URL(link.href, window.location.href);
                    url.hash = "";
                    const href = url.toString();
                    if (prefetchedUrls.has(href)) {
                        return;
                    }
                    prefetchedUrls.add(href);
                    const hint = document.createElement("link");
                    hint.rel = "prefetch";
                    hint.href = href;
                    hint.as = "document";
                    document.head.appendChild(hint);
                };
                document.querySelectorAll(".sparta-header-nav .sparta-main-menu > li > a").forEach((link) => {
                    link.addEventListener("pointerenter", () => prefetch(link), { passive: true });
                    link.addEventListener("focus", () => prefetch(link), { passive: true });
                    link.addEventListener("touchstart", () => prefetch(link), { passive: true });
                    link.addEventListener("click", () => {
                        if (canPrefetch(link)) {
                            document.body.classList.add("sparta-page-navigating");
                        }
                    });
                });
                const warmMainMenuLinks = () => {
                    if (navigator.connection?.saveData) {
                        return;
                    }
                    document.querySelectorAll(".sparta-header-nav .sparta-main-menu > li > a").forEach(prefetch);
                };
                const scheduleWarmup = () => {
                    if ("requestIdleCallback" in window) {
                        window.requestIdleCallback(warmMainMenuLinks, { timeout: 3000 });
                    } else {
                        window.setTimeout(warmMainMenuLinks, 1800);
                    }
                };
                if (document.readyState === "complete") {
                    scheduleWarmup();
                } else {
                    window.addEventListener("load", scheduleWarmup, { once: true });
                }
            };
            const fitOutlineText = () => {
                const lines = [...document.querySelectorAll(".outline-text-line1, .outline-text-line2")];
                if (!lines.length) {
                    return;
                }
                if (window.innerWidth > 1100) {
                    lines.forEach((line) => {
                        line.style.removeProperty("font-size");
                        line.style.removeProperty("--sparta-outline-mobile-font-size");
                    });
                    return;
                }
                const maxSize = 42;
                const minSize = 18;
                lines.forEach((line) => {
                    line.style.fontSize = `${maxSize}px`;
                    line.style.setProperty("--sparta-outline-mobile-font-size", `${maxSize}px`);
                });
                const availableWidth = Math.min(...lines.map((line) => {
                    const parentWidth = line.parentElement?.getBoundingClientRect().width || window.innerWidth;
                    return Math.min(parentWidth, window.innerWidth);
                })) - 44;
                const widestLine = Math.max(...lines.map((line) => line.scrollWidth));
                if (!availableWidth || !widestLine) {
                    return;
                }
                const fittedSize = Math.max(minSize, Math.min(maxSize, Math.floor(maxSize * (availableWidth / widestLine))));
                lines.forEach((line) => {
                    line.style.fontSize = `${fittedSize}px`;
                    line.style.setProperty("--sparta-outline-mobile-font-size", `${fittedSize}px`);
                });
            };
            measureRedMenu();
            updateHeaderState();
            enhanceMobileSubmenus();
            enhanceMainMenuNavigation();
            scheduleHeaderVideoLoad();
            fitOutlineText();
            document.fonts?.ready.then(fitOutlineText);
            window.addEventListener("scroll", updateHeaderState, { passive: true });
            window.addEventListener("resize", () => {
                measureRedMenu();
                updateHeaderState();
                fitOutlineText();
            });
            if (toggle && panel) {
                toggle.addEventListener("click", () => {
                    setMobileMenuOpen(!document.body.classList.contains("sparta-mobile-menu-open"));
                });
                panel.addEventListener("click", (event) => {
                    if (event.target.closest("a")) {
                        setMobileMenuOpen(false);
                    }
                });
                document.addEventListener("keydown", (event) => {
                    if (event.key === "Escape") {
                        setMobileMenuOpen(false);
                    }
                });
                window.addEventListener("resize", () => {
                    if (window.innerWidth > 1280) {
                        setMobileMenuOpen(false);
                        closeMobileSubmenus();
                    }
                });
            }
        })();
//# sourceURL=sparta-2026-header-scroll-js-after
</script>
