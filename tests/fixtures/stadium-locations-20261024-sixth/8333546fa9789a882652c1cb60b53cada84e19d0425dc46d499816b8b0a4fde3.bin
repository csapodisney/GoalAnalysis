};
</script>
<script>
(function () {

	ensureDefaultAgeCheck();

	/* ======================================================
	   BETTING ADS – STORAGE HELPERS
	   ===
	=================================================== */

	function ensureDefaultAgeCheck() {
		const ageStored = localStorage.getItem('agecheck24');
		const bettingStored = localStorage.getItem('bettingads');

		// Eerste bezoek → defaults
		if (ageStored === null) {
			localStorage.setItem('agecheck24', '1');
		}

		if (bettingStored === null) {
			localStorage.setItem('bettingads', '1');
		}
	}



	function setBettingAds(enabled) {
		localStorage.setItem('bettingads', enabled ? '1' : '0');

		const toggle = document.getElementById('betting-ads');
		if (toggle) {
			toggle.checked = enabled;
			updateBettingAdsLabel(enabled);
		}
	}
	
	function updateBettingAdsLabel(checked) {
		const label = document.querySelector('.BettingAdsToggleValue');
		if (!label) return;

		label.textContent = checked ? 'Aan' : 'Uit';
	}


	function restoreBettingAdsFromStorage() {
		const toggle = document.getElementById('betting-ads');
		if (!toggle) return;

		const saved = localStorage.getItem('bettingads');
		if (saved !== null) {
			toggle.checked = saved === '1';
		}
	}


	/* ======================================================
	   BETTING ADS BLOCK (HEADER)
	   ====================================================== */

	function injectBettingAdsContextAware() {
		const dialog = document.getElementById('CybotCookiebotDialog');
		if (!dialog) return;

		const template = dialog.getAttribute('data-template');

		// 1️⃣ Eerste banner
		if (template === 'banner') {
			const header = document.getElementById('CybotCookiebotDialogHeaderLogosWrapper');
			if (header) {
				//injectBettingAdsBlock(header);
			}
		}

		// 2️⃣ Instellingen via icoon
		if (template === 'settings') {
			const body = document.getElementById('CybotCookiebotDialogBody');
			if (body) {
				//injectBettingAdsBlock(body);
			}
		}
	}


	function injectBettingAdsBlock(container) {
		if (!container || container.querySelector('#betting-ads')) return;

		const block = document.createElement('div');
		block.innerHTML = `
			<div class="BettingAdsBlock">
				<div class="BettingAdsTitle">Gokadvertenties</div>
				<span class="BettingAdsToggleLabel">
					Alleen actief als je 24 jaar of ouder bent.
					Schakel uit om gokadvertenties te vermijden.
				</span>
				<label class="BettingAdsToggle">
					<input type="checkbox" id="betting-ads">
					<span class="BettingAdsToggleSlider"></span>
					<span class="BettingAdsToggleValue">Aan</span>
				</label>
			</div>
		`;

		container.prepend(block);

		const checkbox = block.querySelector('#betting-ads');

		// herstel state
		restoreBettingAdsFromStorage();

		// label correct zetten na restore
		updateBettingAdsLabel(checkbox.checked);

		checkbox.addEventListener('change', () => {
			setBettingAds(checkbox.checked);
			updateBettingAdsLabel(checkbox.checked);
		});
	}


	function applyBettingAdsHeader() {
		const wrapper = document.getElementById('CybotCookiebotDialogHeaderLogosWrapper');
		if (!wrapper) return;

		injectBettingAdsBlock(wrapper);
	}

	function applyBettingAdsInSettings() {
		const body = document.getElementById('CybotCookiebotDialogBody');
		if (!body) return;

		//injectBettingAdsBlock(body);
	}


	function observeHeader(wrapper) {
		
		const observer = new MutationObserver(() => {
			applyBettingAdsHeader();
			applyBettingAdsInSettings();
		});

		observer.observe(document.documentElement, {
			childList: true,
			subtree: true
		});

		applyBettingAdsHeader(wrapper);
	}

	function initHeader() {
		const wrapper = document.getElementById('CybotCookiebotDialogHeaderLogosWrapper');
		if (!wrapper) return false;

		observeHeader(wrapper);
		return true;
	}

	const headerInterval = setInterval(() => {
		if (initHeader()) clearInterval(headerInterval);
	}, 100);
	


	/* ======================================================
	   AGE CHECK BUTTONS
	   ====================================================== */

	function setupAgeCheckButtons() {
		const allowAllBtn =
			document.getElementById('CybotCookiebotDialogBodyLevelButtonLevelOptinAllowAll');

		const allowSelectionBtn =
			document.getElementById('CybotCookiebotDialogBodyLevelButtonLevelOptinAllowallSelection');

		if (!allowAllBtn || !allowSelectionBtn) return;

		/* -------- 24+ knop -------- */
		if (!allowAllBtn.dataset.agecheckBound) {
			
			allowAllBtn.addEventListener('click', () => {
			if (allowAllBtn.dataset.fromUnder24 !== '1') {
				// leeftijd = 24+
				localStorage.setItem('agecheck24', '1');

				// betting ads = huidige toggle-stand
				const toggle = document.getElementById('betting-ads');
				if (toggle) {
					setBettingAds(toggle.checked);
				}
			}
			delete allowAllBtn.dataset.fromUnder24;
		});

			
			
			allowAllBtn.dataset.agecheckBound = '1';
		
		
		
		}

		/* -------- <24 knop -------- */
		if (!document.getElementById('SpartaAllowUnder24')) {
			const under24Btn = document.createElement('button');
			under24Btn.id = 'SpartaAllowUnder24';
			under24Btn.textContent = 'Alles toestaan (ik ben jonger dan 24)';

			under24Btn.addEventListener('click', () => {
				localStorage.setItem('agecheck24', '0');
				setBettingAds(false);

				allowAllBtn.dataset.fromUnder24 = '1';
				allowAllBtn.click();
			});

			allowSelectionBtn.parentNode.insertBefore(
				under24Btn,
				allowSelectionBtn
			);
		}
	}

	const buttonObserver = new MutationObserver(() => {
		setupAgeCheckButtons();
	});

	buttonObserver.observe(document.documentElement, {
		childList: true,
		subtree: true
	});

})();
</script>


</body>
