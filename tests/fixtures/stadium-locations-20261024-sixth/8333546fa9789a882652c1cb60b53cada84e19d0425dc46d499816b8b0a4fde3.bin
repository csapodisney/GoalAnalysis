<script id="sparta-child-image-fallbacks-js-after">
(() => {
			const placeholderUrl = "https:\/\/www.sparta-rotterdam.nl\/wp-content\/themes\/spartarotterdam\/images\/logo-sparta-embleem.svg";
			const getBackgroundUrl = (element) => {
				const value = element.style.backgroundImage || window.getComputedStyle(element).backgroundImage;
				const match = value && value.match(/url\(["']?(.*?)["']?\)/);
				return match ? match[1] : "";
			};
			const applyPlaceholder = (element) => {
				element.classList.add("placeholder");
				element.style.backgroundColor = "#000";
				element.style.backgroundImage = `url("${placeholderUrl}")`;
				element.style.backgroundPosition = "center";
				element.style.backgroundRepeat = "no-repeat";
				element.style.backgroundSize = "70% auto";
			};
			const checkElement = (element) => {
				const url = getBackgroundUrl(element);
				if (!url || url === placeholderUrl || element.dataset.spartaFallbackChecked === "1") {
					if (!url) applyPlaceholder(element);
					return;
				}
				element.dataset.spartaFallbackChecked = "1";
				const image = new Image();
				image.onerror = () => applyPlaceholder(element);
				image.src = url;
			};
			const checkAll = () => {
				document.querySelectorAll(".shof-photo, .gen-overview .player-img").forEach(checkElement);
			};
			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", checkAll);
			} else {
				checkAll();
			}
			window.addEventListener("load", checkAll);
		})();
//# sourceURL=sparta-child-image-fallbacks-js-after
</script>
<script id="sparta-heading-normalizer-js-after">
(() => {
			const selector = "h1, h2, h3, h4, h5, h6";
			const replacements = {
				"Æ": "AE", "æ": "ae",
				"Ð": "D", "ð": "d",
				"Ł": "L", "ł": "l",
				"Ø": "O", "ø": "o",
				"Þ": "Th", "þ": "th",
				"ß": "ss"
			};
			const normalizeText = (text) => text
				.replace(/[ÆæðÐŁłØøÞþß]/g, (char) => replacements[char] || char)
				.normalize("NFD")
				.replace(/[\u0300-\u036f]/g, "");
			const normalizeHeading = (heading) => {
				const walker = document.createTreeWalker(heading, NodeFilter.SHOW_TEXT);
				const nodes = [];
				while (walker.nextNode()) {
					nodes.push(walker.currentNode);
				}
				nodes.forEach((node) => {
					const normalized = normalizeText(node.nodeValue);
					if (node.nodeValue !== normalized) {
						node.nodeValue = normalized;
					}
				});
			};
			const normalizeHeadings = (root = document) => {
				if (root.nodeType === Node.ELEMENT_NODE && root.matches(selector)) {
					normalizeHeading(root);
				}
				root.querySelectorAll?.(selector).forEach(normalizeHeading);
			};
			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", () => normalizeHeadings());
			} else {
				normalizeHeadings();
			}
			new MutationObserver((mutations) => {
				mutations.forEach((mutation) => {
					mutation.addedNodes.forEach((node) => normalizeHeadings(node));
				});
			}).observe(document.documentElement, { childList: true, subtree: true });
		})();
//# sourceURL=sparta-heading-normalizer-js-after
</script>
	<script type="text/plain" data-cookieconsent="marketing" async data-type="module" src="https://chatwidget-prod.web.app/embed/init.iife.js" data-watermelon-widget-id="QyDWMZUqJD4" data-watermelon-settings-id="13445"></script>
	
<script>
(function () {
	function ensureSpartaVideoModal() {
		let modal = document.getElementById('videoModal');
		if (modal) {
			applySpartaVideoModalStyles(modal);
			return modal;
		}

		modal = document.createElement('div');
		modal.id = 'videoModal';
		modal.className = 'video-modal';
		modal.style.display = 'none';
		modal.innerHTML =
			'<div class="modal-content">' +
				'<span class="close">&times;</span>' +
				'<div class="video-container">' +
					'<iframe id="youtubeIframe" width="100%" height="100%" frameborder="0" allowfullscreen></iframe>' +
				'</div>' +
			'</div>';
		document.body.appendChild(modal);
		applySpartaVideoModalStyles(modal);

		return modal;
	}

	function applySpartaVideoModalStyles(modal) {
		const content = modal.querySelector('.modal-content');
		const container = modal.querySelector('.video-container');
		const iframe = modal.querySelector('iframe');
		const closeButton = modal.querySelector('.close');

		Object.assign(modal.style, {
			position: 'fixed',
			top: '0',
			left: '0',
			width: '100%',
			height: '100%',
			backgroundColor: 'rgba(0,0,0,0.9)',
			justifyContent: 'center',
			alignItems: 'center',
			zIndex: '999999'
		});

		if (content) {
			Object.assign(content.style, {
				position: 'relative',
				width: '80%',
				maxWidth: '960px'
			});
		}

		if (container) {
			Object.assign(container.style, {
				position: 'relative',
				paddingBottom: '56.25%',
				height: '0'
			});
		}

		if (iframe) {
			Object.assign(iframe.style, {
				position: 'absolute',
				top: '0',
				left: '0',
				width: '100%',
				height: '100%'
			});
		}

		if (closeButton) {
			Object.assign(closeButton.style, {
				position: 'absolute',
				top: '-40px',
				right: '0',
				color: '#fff',
				fontSize: '40px',
				cursor: 'pointer',
				zIndex: '1'
			});
		}
	}

	function closeSpartaVideoModal(modal, iframe) {
		iframe.src = '';
		modal.style.display = 'none';
	}

	window.spartaOpenVideoModal = window.spartaOpenVideoModal || function (videoLink) {
		const videoUrl = videoLink.getAttribute('data-video');
		if (!videoUrl) {
			return true;
		}

		const modal = ensureSpartaVideoModal();
		const iframe = modal.querySelector('#youtubeIframe');
		const closeButton = modal.querySelector('.close');
		const autoplaySeparator = videoUrl.indexOf('?') === -1 ? '?' : '&';

		iframe.src = videoUrl + autoplaySeparator + 'autoplay=1';
		modal.style.display = 'flex';

		closeButton.onclick = function () {
			closeSpartaVideoModal(modal, iframe);
		};

		modal.onclick = function (modalEvent) {
			if (modalEvent.target === modal) {
				closeSpartaVideoModal(modal, iframe);
			}
		};

		return false;
	};

	if (window.spartaVideoModalReady) {
		return;
	}
	window.spartaVideoModalReady = true;

	document.addEventListener('click', function (event) {
		const videoLink = event.target.closest('.video-link[data-video]');
		if (!videoLink) {
			return;
		}

		if (window.spartaOpenVideoModal(videoLink) === false) {
			event.preventDefault();
		}
	}, true);
})();
</script>

