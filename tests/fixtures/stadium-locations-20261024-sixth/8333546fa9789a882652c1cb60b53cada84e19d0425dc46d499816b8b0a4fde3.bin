<style>
.footer-wrapper {
	position: relative;
	font-size: 1.5rem;
    color: #fff;
	background: url('/wp-content/themes/SpartaRotterdam2026/images/bg_footer.jpg') center bottom no-repeat #000;
	background-size: 80% auto;
	height: 25vw;
}

.footer-menu-wrapper {
    background: #000;
    padding: 18px 20px 26px;
}

.footer * {
    font-size: 1.5rem;
    color: #fff;
	
}

.footer-wrapper h5,
.sponsors-wrapper h5 {
    font-family: 'Bazar', sans-serif !important;
    color: #fff !important;
}

h1, h2, h3, h4, h5, h6,
h1[class], h2[class], h3[class], h4[class], h5[class], h6[class] {
    font-family: 'Bazar', sans-serif !important;
}

.footer-nav {
    width: 100%;
    margin: 0;
    padding: 0;
    text-align: center;
    list-style: none;
}

.footer-nav li {
    display: inline-block;
}

.footer-nav a {
    color: #fff;
    text-decoration: none;
}

.footer-nav a:hover {
    color: #fff;
    text-decoration: underline;
}

.footer-nav li .divider:after {
    content: "/";
    margin: 0 5px 0 7px;
}

.footer-nav li:last-child .divider:after {
    content: "";
    display: none;
}

@media (max-width: 1980px) {
    .sponsors-wrapper {
        height: 20vw;
		
    }
}

.sponsors-wrapper {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  background: #000;
  color: white;
  margin-top: 100px;
  padding: 20px;
  height: auto;
  flex-wrap: wrap; /* Zorgt dat het mooi schaalt op mobiel */
  gap: 0px;
 
}

/* Linker kolom: hoofdsponsor */
.logo_main_sponsor {
  flex: 1 1 250px;
  text-align: center;
}

.logo_main_sponsor img {
  max-width: 250px;
  width: 100%;
  height: auto;
}

/* Rechter kolom: overige sponsors */
.logo_other_sponsors {
  flex: 3 1 100px;
}

.logo_other_sponsors .logo_slider {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  justify-content: flex-start;
}

.logo_other_sponsors .item {
  flex: 0 1 150px; /* bepaalt breedte per logo */
  text-align: center;
}

.logo_other_sponsors .item img {
  width: 100%;
  max-width: 120px;
  height: auto;
  filter: brightness(0.9);
  transition: transform 0.3s ease, filter 0.3s ease;
}

.logo_other_sponsors .item img:hover {
  transform: scale(1.05);
  filter: brightness(1.1);
}

/* Optioneel: titels wat stijlen */
.logo_main_sponsor h5,
.logo_other_sponsors h5 {
  color: #fff !important;
  margin-bottom: 10px;
  text-transform: uppercase;
  font-size: 14px;
  letter-spacing: 1px;
}

.logo_slider img {
    background-color: transparent;
    font-size: 0;
    vertical-align: middle;
    -ms-interpolation-mode: bicubic;
}

.logo_other_sponsors {
  display: flex;
  flex-direction: column;
  gap: 40px;
}

.sponsor-category h5 {
  color: #fff !important;
  margin-bottom: 15px;
  font-size: 14px;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.sponsor-category .logo_slider {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
}

@media (max-width: 1280px) {
  .sponsors-wrapper {
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    margin-top: 48px;
    padding: 48px 24px 28px;
    gap: 58px;
  }

  .logo_main_sponsor,
  .logo_other_sponsors {
    flex: 0 0 auto;
    width: 100%;
    max-width: 760px;
  }

  .logo_main_sponsor {
    text-align: center;
  }

  .logo_main_sponsor img {
    max-width: min(420px, 82vw);
  }

  .logo_other_sponsors {
    gap: 58px;
  }

  .sponsor-category {
    width: 100%;
