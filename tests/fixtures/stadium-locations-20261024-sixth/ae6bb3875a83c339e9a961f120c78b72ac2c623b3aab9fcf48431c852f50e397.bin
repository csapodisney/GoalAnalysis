	<script type='text/javascript'>

		function checkScroll() {
		document.body.classList.toggle('scrolled', window.scrollY > 0);
		}

		window.addEventListener('scroll', checkScroll, { passive: true });
		document.addEventListener('DOMContentLoaded', checkScroll);

		$(document).ready(function() {

			$('#cerca_prodotto').change(function() {
				if ($('#cerca_prodotto').val() != '') {
					window.location.href = "https://www.empolifc.it"+'/search?q=' + $('#cerca_prodotto').val();
				}
			})

			$('#so_id_stato').change(function () {
				var selected = $(this).find('option:selected');
				var extra = selected.data('extradata'); 
				console.log(extra);
			})

			$('#iniziali-utente').click(function() {
				$('#info-utente').toggle();
			})

			$('.CONT_PROD .prodotti_home.prod-list .smoothmenu-subcat').clone().insertAfter('.cont-lista-prodotti');
			$('.CONT_PROD .prod-list .breadcrumbs').insertAfter('ol.breadcrumb li:last-child');
			
			$('#fascia_evidenza .section_vis_art').children().removeClass('container');
			$('#fascia_evidenza .owl-item').each(function() {
				$('.art_title, .art_subtitle, .text-art, .readmore', $(this)).wrapAll("<div class='container'><div class='item-box-content'>");
			});

			var num_par = $('.VIS_ART article.cat_class_100068 .text-art p').length;
			var num_img = $('.VIS_ART article.cat_class_100068 .altre-img .zoom').length;
			var pos_img = 0;
			$('.VIS_ART article.cat_class_100068 .altre-img .zoom').each(function() {
				if (pos_img < num_par / 3) {
					num_div = 3 + pos_img * Math.floor(num_par / (num_img + 1));
					$(this).appendTo('.VIS_ART article.cat_class_100068 .text-art p:nth-child(' + num_div + ')');
				}
				pos_img += 1;
			})

			$('.VIS_ART article.cat_class_100068').each(function() {
				$('.art_title, .art_subtitle, .text-art, .altre-img', $(this)).wrapAll("<div class='art_blog_content'><div class='container'><div class='item-box-content'>");
			});


			$('#full_cart').click(function(e) {
				e.preventDefault();
				$('#cart-checkout').load("https://www.empolifc.it/cart").addClass('cart-visible');
			})
			$(document).on('click', '.close-cart', function(e) {
				e.preventDefault();
				$('#cart-checkout').removeClass('cart-visible');
			})

			$('section.section_cont_art.full-page').each(function(){
				if ($(this).hasClass('gallery-only')) {
					$('article.vis-articolo', $(this)).each(function() {
						$('div.item-box:not(.altre-img)', $(this)).wrapAll("<div class='contenuti-articolo'>");
					})
				} else {
					$('article.vis-articolo', $(this)).each(function() {
						$('div.item-box:not(.first-img-articolo)', $(this)).wrapAll("<div class='contenuti-articolo'>");
					})
				}
			})


			$(".totop").hide();  
			$('#notifiche').notify(); 
			
			$(window).scroll(function(){
				if ($(this).scrollTop()>400) {
					$('.totop').fadeIn();
				} else {
					$('.totop').fadeOut();
				}
			});
			
			$('.totop a').click(function (e) {
				e.preventDefault();
				$('body,html').animate({scrollTop: 0}, 500);
				return false;
			});
			

			$('.menu-link').click(function() {
				
				$('.menu-link').each(function() {
					$(this).toggleClass('active');
				});
				$('.menu-col-sx').toggleClass('open');
				$('body').toggleClass('open');

			});

			$('.section_cont_art.faq .text-art').wrapInner('<div class="faq-inner"></div>');
			$('.section_cont_art.faq .art_title').on('click', function() {
				var section = $(this).closest('.faq');
				if (!section.hasClass('open')) {
					$('.section_cont_art.faq .faq.open .text-art').slideUp();
					$('.section_cont_art.faq .faq').removeClass('open');
					section.addClass('open');
					section.find('.text-art').slideDown();
				} else {
					section.find('.text-art').slideUp();
					section.removeClass('open');
				}
			});

			$('.-------------------puls_add_cart').click(function(e) {
				
				e.preventDefault();

				var pulsante = $(this);

				var id_var = pulsante.attr('rel');
				var quant_var = 1;

				if ($('#var_' + id_var).length)
					quant_var = parseInt($('#var_' + id_var).val());
				
				start_icon = pulsante.attr('src');

				pulsante.prop('disabled', true).attr('src', 'https://www.empolifc.it/grafiche/personalizzate/empolifc/style/images/loader.svg');
				//Tento il salvataggio
				if (quant_var > 0) {
					$.ajax({
						url: "https://www.empolifc.it/php/carrello_suggest.php",
						dataType: 'json',
						type: 'POST',
						data: {
							'action': 'add',
							'code': id_var,
							'login_client_name': '_EMPOLIFC_',
							'quant': quant_var,
							'url_level': '',
							'url_script_name': '',
							'no_min_quant' : true
						}
					}).done(function ( data ) {
						if (data.esito == 1) {
							if ($('#var_' + id_var).is(":visible"))
								$('#var_' + id_var).val('');
							// Aggiornare catalogo!!!
							quant_fin = parseInt($('#sintesi_carrello_qta').attr('data-quant')) + quant_var;

							$('#sintesi_carrello_qta').attr('data-quant', quant_fin).html(quant_fin);

						} else {
							alert('Prodotto non aggiunto! - ' + data.msg);
						}

						pulsante.prop('disabled', false).attr('src', start_icon);
						$('#cart-checkout').load("https://www.empolifc.it/cart").addClass('cart-visible');

					});
				}

				
			});

		});
		
		function showLoadingImg(_id) {
			var position = $('#'+_id).position();
			//alert(_id);
			//alert(position.top);
			//alert(position.left);
			$('#button_OK-loading-img').css( {'z-index' : 99999, 'top' : position.top+15, 'left' : position.left+45, 'display':'inline' } );
			$('#button_OK-loading-img').show('fast');
			//alert('p');
		}
		function hideLoadingImg(_id) {
			$('#button_OK-loading-img').hide();
		}
		hideLoadingImg();
		


		document.addEventListener('DOMContentLoaded', function () {
			var topItems = document.querySelectorAll('#cat_catalogo .ul0 > li');

			topItems.forEach(function (li) {
				var link = li.querySelector(':scope > .cont_info_cat > .cat_nome > a');
				var hasSub = li.querySelector(':scope > .ul1');
				if (!link || !hasSub) return;

				link.addEventListener('click', function (e) {
					if (!li.classList.contains('open')) {
						e.preventDefault();
						topItems.forEach(function (sibling) {
							if (sibling !== li) sibling.classList.remove('open');
						});
						li.classList.add('open');
					}
					// se è già aperto, il click prosegue normalmente verso l'href
				});
			});

			document.addEventListener('click', function (e) {
				if (!e.target.closest('#cat_catalogo')) {
					topItems.forEach(function (li) { li.classList.remove('open'); });
				}
			});
		});

		function custom_post_success(data, id_form){
			var dest = data.dest;
			$('.newsletter_error').hide();
			$('.newsletter_success').hide();

			function renderSuccess(finalMsg){
				var txt_bonifico = '';
				var puls_view_order = '';

				if (id_form == 'checkout_form') {
					if ($('.mod_pagamento:checked').val() == 'bb') {
						txt_bonifico = "";
					}
					if (data.dest != '')
						puls_view_order = "<a href='https://www.empolifc.it/" + dest + "' class='link_pulsante_form'>Visualizza ordine</a>";

					$('#checkout_form :input').attr("disabled", true);
					$('.link_pulsante_form').remove();
					$('.actions_link').remove();
					$('#sintesi_carrello').html('Il tuo carrello è vuoto');
				}

				$('#' + id_form + ' .success').html(finalMsg + txt_bonifico + puls_view_order);
				$('#' + id_form + ' .success').fadeIn();
				$('#' + id_form + ' .error').fadeOut();

				$('#' + id_form + ' #form_reg_button_OK_loading_img').fadeOut();
				$('#' + id_form + ' #checkout_form_button_OK').fadeOut();

				if (id_form == 'checkout_form') {
					var topPos = $('#' + id_form + ' .success').offset().top - 200;
					
					$('body,html').animate({scrollTop: topPos}, 500);
					
				}
			}

			if (data.esito == 1) {

				if (id_form == 'form_regnews') {
					$('.newsletter_success').html(data.msg);
					$('.newsletter_success').addClass('newsletter_response');
					$('.newsletter_success').show();
					$('#' + id_form + " :input[type='submit']").attr("disabled", true);
					$('#' + id_form + ' .class_submit').html('');
					return; // ramo indipendente, nessun redirect "dest" da valutare qui sotto
				}

				var isCheckoutCC = (id_form == 'checkout_form'
					&& $('#checkout_form').valid()
					&& $("input[name='checkout_params[mod_pagamento]']:checked").val() == 'cc');

				if (isCheckoutCC) {

					$('#orderId').val(data.id_backoffice);
					var importo = parseInt(totale_con_sped_voucher.toFixed(2) * 100);

					(async () => {
						$('#info_popup_checkout').html("Autorizzazione del pagamento in corso.");
						$('#block-payment-div').css('display', 'flex');
						let esito_pagamento = await procedi_pagamento(importo);

						if (esito_pagamento) {
							$.ajax({
								url: "https://www.empolifc.it/php/gestione_checkout/register_payment.php",
								dataType: 'json',
								type: 'POST',
								data: {
									id_ordine: $('#orderId').val(),
									paymentIntentId: $('#paymentIntentId').val(),
									url_script_name: '',
									url_level: '',
									__LANGUAGE__: 'it',
									ut_id: ''
								}
							}).done(function (paymentData) {

								if (paymentData.esito == 1) {
									var finalMsg = "Ordine salvato con successo.<br>Pagamento ricevuto";
									renderSuccess(finalMsg);

									// document.location.href = "https://www.empolifc.it/cart?action=order&id=" + $('#orderId').val();
								} else {
									$('#card-errors').html(paymentData.message);
									var finalMsg = "Ordine salvato con successo.<br><strong>Il pagamento non è andato a buon fine, si prega di riprovare dalla pagina di visualizzazione dell'ordine: " + paymentData.message + "</strong>";
									renderSuccess(finalMsg);
								}
								$('#block-payment-div').css('display', 'none');

							}).fail(function(){
								$('#block-payment-div').css('display', 'none');
								$('#card-errors').html('');
								var finalMsg = "Ordine salvato con successo.<br>Il pagamento non è andato a buon fine, si prega di riprovare dalla pagina di visualizzazione dell'ordine";
								renderSuccess(finalMsg);
							});

						} else {
							$('#block-payment-div').css('display', 'none');
							var finalMsg = "Ordine salvato con successo.<br><strong>Il pagamento non è andato a buon fine, si prega di riprovare dalla pagina di visualizzazione dell'ordine: " + $('#card-errors').html() + "</strong>";
							renderSuccess(finalMsg);
						}

						return true;
						
					})();

					return; 

				} else {
					// Caso non-checkout o checkout con metodo diverso da cc (es. bonifico)
					$('#block-payment-div').css('display', 'none');
					renderSuccess(data.msg);
				}

			} else if (data.esito == 0) {
				if (id_form == 'form_regnews') {
					$('.newsletter_error').html(data.msg);
					$('.newsletter_error').addClass('newsletter_response');
					$('.newsletter_error').fadeIn();
					$('#' + id_form + " :input[type='submit']").attr("disabled", false);
				} else {
					$('#' + id_form + ' .error').html(data.msg);
					$('#' + id_form + ' .success').fadeOut();
					$('#' + id_form + ' .error').fadeIn();
					$('#' + id_form + ' #form_reg_button_OK_loading_img').fadeIn();
					$('#' + id_form + ' #checkout_form_button_OK').fadeIn();
					$('#' + id_form + " :input[type='submit']").attr("disabled", false);
					$('#block-payment-div').css('display', 'none');
				}
			}

			// Il redirect "dest" generico resta valido solo per i rami che NON sono
			// checkout+cc (quello ha già fatto return sopra, con o senza pagamento riuscito).
			if (dest.length != 0 && data.esito == 1) {
				if (dest == 'self') {
					location.reload();
				} else if (dest == 'back') {
					history.back(-1);
				} else if (dest != undefined && dest != '') {
					document.location.href = "https://www.empolifc.it/" + dest;
				}
			}
		}


					async function procedi_pagamento(importo){

						$('#block-payment-div').css('display', 'flex');

						// Invia la richiesta al backend per creare un PaymentIntent
						const response = await fetch('https://www.empolifc.it/php/gestione_checkout/process_payment_3d.php', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ action: 'create_payment_intent', amount: parseInt(importo)  }) // L'importo dovrebbe essere passato dinamicamente
						});
						const paymentIntent = await response.json();
						// Conferma il pagamento con Stripe.js
						var titolare_carta = $('#titolare_carta').val();
						const result = await stripe.confirmCardPayment(paymentIntent.client_secret, {
							payment_method: {
								card: card,
								billing_details: {
									name: titolare_carta, // Sostituisci con il nome del titolare della carta
								},
							},
						});
						if (result.error) {
							// Mostra l'errore al cliente
							const errorElement = document.getElementById('card-errors');
							errorElement.textContent = result.error.message;
							$('#block-payment-div').css('display', 'none');
							return false;
						} else {
							if (result.paymentIntent.status === 'succeeded') {
								// Il pagamento è stato elaborato con successo
								console.log('Payment succeeded!');
								$('#paymentIntentId').val(result.paymentIntent.id);
								
							} else if (result.paymentIntent.status === 'requires_action') {
								// La conferma del pagamento richiede ulteriori azioni dell'utente
								stripe.handleCardAction(result.paymentIntent.client_secret).then(function(result) {
									if (result.error) {
										// Mostra l'errore al cliente
										const errorElement = document.getElementById('card-errors');
										errorElement.textContent = result.error.message;
										$('#block-payment-div').css('display', 'none');
										return false;
									} else {
										// Conferma nuovamente il PaymentIntent
										stripe.confirmCardPayment(result.paymentIntent.client_secret).then(function(result) {
											if (result.error) {
												// Mostra l'errore al cliente
												const errorElement = document.getElementById('card-errors');
												errorElement.textContent = result.error.message;
												$('#block-payment-div').css('display', 'none');
												return false;
											} else {
												if (result.paymentIntent.status === 'succeeded') {
													// Il pagamento è stato elaborato con successo
													console.log('Payment succeeded!');
													$('#paymentIntentId').val(result.paymentIntent.id);
												}
											}
										});
									}
								});
							}
						}
						$('#block-payment-div').css('display', 'none');
						return true;
					}		

		function info_dialog(message, title, selector, cssclass, append){
			if (typeof title == 'boolean' && !title) {
				title = '';
			}else{
				if (typeof title != 'string' || title.length == 0) title = jsText.dialog_default_text_info_title /*'Info'*/;
			}
			title = title.trim();

			if (typeof message != 'string' || message.trim().length == 0) return;

			if (typeof selector != 'string' || isBlank(selector)) selector = '#info_dialog';

			let dialog = $(selector);
			if (dialog.length != 1) return;
			if (dialog.is(':visible')) {
				let thisId = dialog.attr('id');
				if (isBlank(thisId)) return;
				let name = thisId.sanitize().replace(/\s/, '');
				visibileDialog[name] = {
					func: 'info_dialog',
					arg: arguments
				}
				dialog.modal('hide');
				return;
			}

			dialog.attr('class', '');
			dialog.addClass('modal fade');
			if (typeof cssclass == 'string' && !isBlank(cssclass)){
				dialog.addClass(cssclass.sanitize());
			}

			let titleBox = $('.modal-title', dialog);
			let messageBox = $('.modal-body', dialog);

			titleBox.html(title);
			messageBox.html(message);
			if (!isBlank(append)) messageBox.append(append);
			dialog.modal('show');
		}
		

		
