		document.querySelectorAll('article.vis-articolo').forEach(article => {
			const backLink = article.querySelector('.backLink');
			if (!backLink) return;

			const altreImg = article.querySelector('.item-box.altre-img');
			const videosBox = article.querySelector('.item-box.videos-box');

			// priorità a videos-box perché nel DOM viene dopo altre-img
			const target = videosBox || altreImg;

			if (target) {
				target.insertAdjacentElement('afterend', backLink);
			}
			// se non esistono né altre-img né videos-box, backLink resta dov'è
		});

