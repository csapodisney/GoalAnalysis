																	<div class="item-box mappa_address">
										<p><strong>Indirizzo: </strong>Stadio Carlo Castellani</p>										<p><strong>Comune: </strong>Empoli</p>																			</div>
																											
																														
																														
																														
																														
																														
																														
																																					<div class="item-box authorbox">
							<div class="detail">
								<ul class="checklist">
								 
									<li>
										<div class='item-allegato'>
										<a href="https://www.empolifc.it/cms/custom/files/100114/ct50012_id240937_t2/REGOLAMENTO-DUSO-CASTELLANI-COMPUTER-GROSS-ARENA-DI-EMPOLI-E-NORME-ETICHE.pdf" target="_blank">
																																		<span style='display:inline-block;'><p>REGOLAMENTO D&rsquo;USO STADIO CARLO CASTELLANI COMPUTER GROSS ARENA DI EMPOLI E NORME ETICHE</p></span>
