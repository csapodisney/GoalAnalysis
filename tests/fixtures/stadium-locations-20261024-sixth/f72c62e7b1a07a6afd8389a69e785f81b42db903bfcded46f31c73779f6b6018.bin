              <a href="#" id="print-page"> <svg class="icon pnrr_icon_dropdown left"><use xlink:href="/svg/agid.svg#it-print"></use></svg>Stampa</a>
          </li>
          <li>
              <a href="#" id="hear-page"> <svg class="icon pnrr_icon_dropdown left"><use xlink:href="/bootstrap-italia/dist/svg/sprites.svg#it-hearing"></use></svg>Ascolta</a>
          </li>
      </ul>
    </div>
  </div>
</div>

<script>
    const hearLink = document.getElementById('hear-page');
    const synth = window.speechSynthesis;
    let sessionId = 0;
    let utterances = [];
    let isReading = false;

    document.addEventListener('DOMContentLoaded', function() {

        document.getElementById('print-page').addEventListener('click', function (e) {
            e.preventDefault();
            const dropdown = document.querySelector('.dropdown-menu.show');
            if (dropdown) dropdown.classList.remove('show');
            const dropdownToggle = document.querySelector('[aria-expanded="true"]');
            if (dropdownToggle) dropdownToggle.setAttribute('aria-expanded', 'false');
            setTimeout(function () { window.print(); }, 100);
        });

        if (!('speechSynthesis' in window)) {
            console.warn('Text-to-Speech non supportato');
            return;
        }

        if (hearLink) {
            hearLink.addEventListener('click', function (e) {
                e.preventDefault();

                if (isReading) {
                    stopTTS();
                    return;
                }

                let combinedText = "";

                const contentElements = document.querySelectorAll('.to-read');
                console.log(contentElements);
                contentElements.forEach(element => {
                    combinedText += element.textContent.trim() + " ";
                });

                console.log(combinedText);

                const pageContents = document.querySelectorAll('.page-content');
                console.log(pageContents);
                pageContents.forEach(element => {
                    const h2 = element.querySelector('h2');
                    if (h2 && ['Descrizione', "Cos'è"].includes(h2.textContent.trim())) {
                        const clone = element.cloneNode(true);
                        clone.querySelectorAll('.anchor-content').forEach(anchor => anchor.remove());
                        combinedText += clone.innerText + " ";
                    }
                });

                const finalMainText = combinedText.replace(/\s+/g, ' ').trim();

                if (!finalMainText) {
                    alert('Nessun contenuto da leggere');
                    return;
                }

                const chunks = finalMainText.match(/[^.!?]+[.!?]*/g) || [finalMainText];
                startTTS(chunks);
            });
        }

        setInterval(() => {
            if (isReading && synth.speaking) {
                synth.pause();
                synth.resume();
            }
        }, 10000);
    });

    function startTTS(chunks) {
        isReading = true;
        utterances = [];
        sessionId++;
        const currentSession = sessionId;
        updateUI(true);

        let currentChunk = 0;

        function playNext() {
            if (currentSession !== sessionId || !isReading) return;
            if (currentChunk >= chunks.length) {
                stopTTS();
                return;
            }

            const utterance = new SpeechSynthesisUtterance(chunks[currentChunk].trim());
            utterance.lang = 'it-IT';
            utterance.rate = 1;
            utterances.push(utterance);

            utterance.onend = () => {
                if (currentSession !== sessionId || !isReading) return;
                currentChunk++;
                playNext();
            };

            utterance.onerror = (event) => {
                if (event.error !== 'interrupted') {
                    console.error('Errore TTS:', event);
                    stopTTS();
                }
            };

            synth.speak(utterance);
        }

        synth.cancel();
        setTimeout(playNext, 100);
    }

    function stopTTS() {
        isReading = false;
        sessionId++;
        utterances = [];
        synth.cancel();
        updateUI(false);
    }

    function updateUI(reading) {
        if (!hearLink) return;
        if (reading) {
            hearLink.innerHTML = '<svg class="icon pnrr_icon_dropdown left"><use xlink:href="/bootstrap-italia/dist/svg/sprites.svg#it-close"></use></svg>Stop';
        } else {
            hearLink.innerHTML = '<svg class="icon pnrr_icon_dropdown left"><use xlink:href="/bootstrap-italia/dist/svg/sprites.svg#it-hearing"></use></svg>Ascolta';
        }
    }

</script>
