<script type="text/javascript">
(function($) {

    /**
     * initMap
     *
     * Renders a Google Map onto the selected jQuery element
     *
     * @date    22/10/19
     * @since   5.8.6
     *
     * @param   jQuery $el The jQuery element.
     * @return  object The map instance.
     */
    function initMap($el) {

        // Find marker elements within map.
        var $markers = $el.find('.marker');

        // Create gerenic map.
        var mapArgs = {
            zoom: $el.data('zoom') || 16,
            mapTypeId: google.maps.MapTypeId.ROADMAP,
            disableDefaultUI: true,
        };
        var map = new google.maps.Map($el[0], mapArgs);

        // Add markers.
        map.markers = [];
        $markers.each(function() {
            initMarker($(this), map);
        });

        // Center map based on markers.
        centerMap(map);

        // Return map instance.
        return map;
    }

    /**
     * initMarker
     *
     * Creates a marker for the given jQuery element and map.
     *
     * @date    22/10/19
     * @since   5.8.6
     *
     * @param   jQuery $el The jQuery element.
     * @param   object The map instance.
     * @return  object The marker instance.
     */
    function initMarker($marker, map) {

        // Get position from marker.
        var lat = $marker.data('lat');
        var lng = $marker.data('lng');
        var latLng = {
            lat: parseFloat(lat),
            lng: parseFloat(lng)
        };

        // Create marker instance.
        var marker = new google.maps.Marker({
            position: latLng,
            map: map
        });

        // Append to reference for later use.
        map.markers.push(marker);

        // If marker contains HTML, add it to an infoWindow.
        if ($marker.html()) {

            // Create info window.
            var infowindow = new google.maps.InfoWindow({
                content: $marker.html()
            });

            // Show info window when marker is clicked.
            google.maps.event.addListener(marker, 'click', function() {
                infowindow.open(map, marker);
            });
        }
    }

    /**
     * centerMap
     *
     * Centers the map showing all markers in view.
     *
     * @date    22/10/19
     * @since   5.8.6
     *
     * @param   object The map instance.
     * @return  void
     */
    function centerMap(map) {

        // Create map boundaries from all map markers.
        var bounds = new google.maps.LatLngBounds();
        map.markers.forEach(function(marker) {
            bounds.extend({
                lat: marker.position.lat(),
                lng: marker.position.lng()
            });
        });

        // Case: Single marker.
        if (map.markers.length == 1) {
            map.setCenter(bounds.getCenter());

            // Case: Multiple markers.
        } else {
            map.fitBounds(bounds);
        }
    }

    // Render maps on page load.
    $(document).ready(function() {
        $('.acf-map').each(function() {
            var map = initMap($(this));
        });
    });

})(jQuery);
</script>

<section class="post-content band  " data-aos="fade-up" data-aos-duration="800">
    <div class="container flex-justify-c">
        <div class="seven columns">
            <h5>Blackburn Rovers FC are one of the few clubs to have won the Premier League, taking the title in 1995. The club has competed in both the Premier and Football League and is one of only three clubs to have been a founding member of both.</h5>
<p>&nbsp;</p>
<h3>Stadium Tours</h3>
<p>Places are available for fans to take part in The Rovers Experience, the clubs exclusive stadium tour. Dates can be arranged to suit the customer’s needs and convenience. To book on a tour visit <a href="http://www.onerovers.co.uk/">www.rovers.co.uk</a> or if you have a party of six or more call 01254 296110 for a tour to be arranged at your convenience. Alternatively email <a href="mailto:tours@rovers.co.uk">tours@rovers.co.uk</a></p>
<p>The Rovers Experience not only takes a look at what goes on behind the scenes at Ewood Park, but also celebrates the history of the football club. Blackburn Rovers was after all one of the founding members of the Football League in 1888 and the Premier League in 1992.</p>
<p>&nbsp;</p>
<h3>Food and Drink</h3>
<p>Blues Bar at Ewood Park offers homemade food between 12.00pm and 2.30pm Monday – Thursday and 12.00pm – 8.00pm Friday – Sunday. The bar can also be hired for private parties and functions. For more information call 01254 296202</p>
                    </div>
            </div>
</section>

