<style>
/* ===== R&N Elementor Mega Menu – Styles ===== */
.rnmm{
  position:relative;
}
.rnmm .rnmm-nav{
  width:100%;
}
.rnmm .rnmm-top{
  display:flex;
  flex-wrap:nowrap;
  gap:30px;
  list-style:none;
  margin:0;
  padding:0;
  align-items:center;
}
.rnmm .rnmm-top a{
  display:block;
  text-decoration:none;  
  color: #000000 !important;
}
.rnmm .rnmm-top-link{
  padding:10px 0;
}

/* Panel über gesamte Breite */
.rnmm .rnmm-panel{
  position:absolute;
  left:0;
  right:0;
  top:100%;
  background:#000;
  font-size: 18px;
  color:#fff;
  z-index:999;
}
.rnmm .rnmm-panel[hidden]{
  display:none;
}
.rnmm .rnmm-panel-inner{
  max-width: 100%;
  margin:0 30px;
  padding:25px 0;
}

/* Dropdown: Spalten (Level-2) */
.rnmm .rnmm-dropdown[hidden]{
  display:none;
}
.rnmm .rnmm-columns{
  display:flex;
  flex-wrap:wrap;
  gap:30px;}
.rnmm .rnmm-col{
  min-width:200px;
  flex:1 1 200px;
}
.rnmm .rnmm-heading{
  display:block;
  font-weight:700;
   text-transform: uppercase;
  margin-bottom:15px;
  color: #ffffff !important;
}
.rnmm .rnmm-sublist{
  list-style:none;
  margin:0;
  padding:0;
}
.rnmm .rnmm-sublist li{
  margin:6px 0;
}
.rnmm .rnmm-sublist a{
  text-decoration:none;
  text-transform: uppercase;
  color:#ffffff;
}

.rnmm .rnmm-sublist a:hover {
	color: #E10019;
}

/* Fokus & A11y */
.rnmm a:focus{
  outline:2px solid #fff;
  outline-offset:2px;
}

/* Mobile: Panel im Flow unter dem Top-Menü */
@media (max-width: 1024px){
  .rnmm .rnmm-panel{
    position:static;
  }
}

/* RNMM patch: hover red for items without children */
.rnmm .rnmm-heading.rnmm-no-l3:hover { color: #E10019 !important; }
.rnmm .rnmm-top-link.rnmm-top-no-l2:hover { color: #E10019 !important; }

.menu-hider {
    display: initial !important;
}
</style>
